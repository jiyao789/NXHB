<view class="page-container">
  <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/bg.png" class="bg-absolute" mode="scaleToFill" />
  <view class="nav-wrapper" style="padding-top: {{safeAreaTop}}px;">
    <view class="nav-content">
      <view class="back-btn" hover-class="btn-hover" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <text class="nav-title">月度计划</text>
    </view>
  </view>
  <view class="status-cards-container">
    <view wx:for="{{statusList}}" wx:key="type" class="status-item">
      <view class="status-card-box">
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/server/index/monthly/month_card_bg.png" class="card-bg" mode="scaleToFill" />
        <image src="{{item.icon}}" class="card-icon" mode="aspectFit" />
        <view class="card-count-group" style="color: {{item.color}};">
          <text class="count-num">{{item.count}}</text>
          <text class="count-unit">项</text>
        </view>
      </view>
      <text class="status-title">{{item.title}}</text>
    </view>
  </view>
  <view class="main-content">
    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/volunteer/bg_down.png" class="content-bg" mode="scaleToFill" />
    <view class="content-header">
      <text class="overview-title">月度概览</text>
      <view class="manage-btn" bindtap="handleManage" hover-class="btn-hover">
        <text>{{isManageMode ? '完成' : '管理'}}</text>
      </view>
    </view>
    <scroll-view scroll-y class="list-scroll" show-scrollbar="{{false}}">
      <view class="list-container {{isManageMode ? 'manage-mode' : ''}}">
        <view wx:for="{{overviewList}}" wx:key="id" class="list-item-wrapper">
          <!-- 选择圆圈 -->
          <view wx:if="{{isManageMode}}" class="select-box" bindtap="toggleSelectItem" data-id="{{item.id}}">
            <view class="select-circle {{util.indexOf(selectedIds, item.id) > -1 ? 'selected' : ''}}"></view>
          </view>
          <view class="list-item" bindtap="{{isManageMode ? 'toggleSelectItem' : ''}}" data-id="{{item.id}}">
            <image src="{{item.iconPath}}" class="item-icon" mode="aspectFit" />
            <view class="item-text-group">
              <text class="item-title">{{item.title}}</text>
              <view class="item-subtitle" catchtap="handleShowUsage" data-content="{{item.subTitle}}">
                <text class="usage-btn-text">使用须知</text>
              </view>
            </view>
            <view class="status-capsule" style="background-color: {{item.statusColor}};">
              {{item.status}}
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <!-- 底部管理栏 -->
    <view class="manage-footer {{isManageMode ? 'show' : ''}}">
      <view class="footer-left" bindtap="toggleSelectAll">
        <view class="select-circle {{selectedIds.length === overviewList.length && overviewList.length > 0 ? 'selected' : ''}}"></view>
        <text>全选</text>
      </view>
      <view class="footer-right">
        <view class="delete-btn {{selectedIds.length > 0 ? '' : 'disabled'}}" bindtap="handleDelete">
          删除({{selectedIds.length}})
        </view>
      </view>
    </view>
  </view>
  <!-- 使用须知自定义弹窗 -->
  <view class="custom-modal-mask {{showUsageModal ? 'show' : ''}}" bindtap="handleCloseUsage">
    <view class="custom-modal-box" catchtap="stopPropagation">
      <view class="custom-modal-header">
        <text class="custom-modal-title">使用须知</text>
        <view class="modal-close-icon" bindtap="handleCloseUsage"></view>
      </view>
      <scroll-view scroll-y class="custom-modal-content">
        <text class="custom-modal-text">{{usageContent}}</text>
      </scroll-view>
      <view class="custom-modal-footer">
        <view class="custom-modal-btn" hover-class="btn-hover" bindtap="handleCloseUsage">
          我知道了
        </view>
      </view>
    </view>
  </view>
  <!-- WXS 辅助工具 -->
  <wxs module="util">
    module.exports = {
      indexOf: function(arr, val) {
        return arr.indexOf(val);
      }
    }
  </wxs>
</view>