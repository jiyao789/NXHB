/* ==========================================
   追加修复：全局与缺失原子类补充
========================================== */

/* 1. 修复全局盒模型 (非常关键：解决元素被 padding 撑大导致的变形错位) */
view, text, image, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

/* 2. 补充缺失的边框类 (用于列表项标签和预约按钮徽标) */
.border { border-width: 2rpx; border-style: solid; }
.border-white { border-color: #ffffff; }

/* 3. 补充缺失的尺寸类 (用于预约弹窗的关闭按钮和选项勾选框) */
.w-12 { width: 96rpx; }
.h-6 { height: 48rpx; }
.w-6 { width: 48rpx; }

/* 4. 补充缺失的间距类 (用于预约弹窗确认按钮) */
.m-0 { margin: 0; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.pb-2 { padding-bottom: 16rpx; }

/* 5. 补充排版与颜色 (用于文本居中和灰色字体) */
.text-center { text-align: center; }
.text-gray-400 { color: #9ca3af; }

/* 6. 补充阴影类 (用于预约服务确认按钮) */
.shadow-lg { box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -2rpx rgba(0, 0, 0, 0.05); }