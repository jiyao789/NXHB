.page-container {
  position: relative;
  height: 100vh;
  width: 100%;
  background-color: black;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 50;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.back-btn {
  display: flex;
  height: 64rpx;
  width: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background-color: rgba(0, 0, 0, 0.4);
  /* cover-view 不支持 backdrop-filter，但因为在层级最高端可以使用普通 view 包裹 */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.icon-back {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid white;
  border-left: 4rpx solid white;
  transform: rotate(-45deg);
  margin-left: 8rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

/* 相机视图 */
.camera-view {
  height: 100%;
  width: 100%;
  position: relative;
}

.overlay-container {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.overlay-mask {
  background-color: rgba(0, 0, 0, 0.5);
}

.flex-1 {
  flex: 1;
}

/* 扫描区域行 */
.scan-row {
  display: flex;
  height: 520rpx; /* 大约等于 vue 里面的 260px */
  width: 100%;
  flex-direction: row;
}

.scan-box {
  position: relative;
  height: 520rpx;
  width: 520rpx;
}

/* 四个边角 */
.corner {
  position: absolute;
  height: 32rpx;
  width: 32rpx;
  border-color: white;
}

.top-left { left: 0; top: 0; border-left: 4rpx solid white; border-top: 4rpx solid white; }
.top-right { right: 0; top: 0; border-right: 4rpx solid white; border-top: 4rpx solid white; }
.bottom-left { bottom: 0; left: 0; border-bottom: 4rpx solid white; border-left: 4rpx solid white; }
.bottom-right { bottom: 0; right: 0; border-bottom: 4rpx solid white; border-right: 4rpx solid white; }

/* 扫描线动画 */
.scan-line {
  position: absolute;
  left: 0;
  width: 100%;
  height: 4rpx;
  background-color: #FFD700;
  animation: scan-move 2.5s linear infinite;
}

.hint-container {
  position: relative;
}

.scan-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 底部控制区 */
.bottom-controls {
  height: 360rpx; /* 大约等于 180px */
  width: 100%;
  background-color: white;
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 64rpx;
}

.flash-btn-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.flash-btn {
  display: flex;
  height: 96rpx;
  width: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f3f4f6;
  transition: all 0.3s;
}

.flash-on {
  background-color: #fef08a; /* bg-yellow-100 */
}

.flash-icon {
  height: 48rpx;
  width: 32rpx;
}

.opacity-100 { opacity: 1; }
.opacity-40 { opacity: 0.4; }

.flash-text {
  font-size: 24rpx;
  color: #333333;
}

/* 关键帧动画必须在原生 CSS 中完整声明 */
@keyframes scan-move {
  0% { top: 0; opacity: 0.6; }
  50% { top: 90%; opacity: 1; }
  100% { top: 0; opacity: 0.6; }
}