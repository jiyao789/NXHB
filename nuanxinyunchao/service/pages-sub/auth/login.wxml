<view class="container">
  <!-- 占位符 -->
  <view class="safe-area-header" style="height: {{safeAreaTop + 44}}px"></view>
  <!-- Logo 与 标题区域 -->
  <view class="logo-section">
    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/server/mine/logo.png" class="logo-img" mode="aspectFit" />
    <text class="title-main">"暖新云巢"小程序</text>
    <text class="title-main">服务端</text>
  </view>
  <!-- 表单区域 -->
  <view class="form-container">
    <!-- 手机号/账号输入框 -->
    <view class="input-item">
      <view class="{{loginType === 'code' ? 'icon-phone' : 'icon-user'}}"></view>
      <input class="input-field" type="text" maxlength="11" placeholder="{{loginType === 'code' ? '请输入手机号' : '请输入账号'}}" placeholder-class="placeholder-text" value="{{formData.mobile}}" data-field="mobile" bindinput="handleInput" />
      <view wx:if="{{formData.mobile}}" class="icon-close" bindtap="clearMobile"></view>
    </view>
    <!-- 验证码输入框 + 发送按钮 (仅在验证码登录时显示) -->
    <view class="row-gap" wx:if="{{loginType === 'code'}}">
      <view class="input-item flex-1">
        <view class="icon-security"></view>
        <input class="input-field" type="number" maxlength="6" placeholder="请输入验证码" placeholder-class="placeholder-text" value="{{formData.code}}" data-field="code" bindinput="handleInput" />
      </view>
      <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="handleSendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </view>
    </view>
    <!-- 密码输入框 (仅在密码登录时显示) -->
    <view class="input-item mt-4" wx:if="{{loginType === 'password'}}">
      <view class="icon-security"></view>
      <input class="input-field" type="password" maxlength="20" placeholder="请输入密码" placeholder-class="placeholder-text" value="{{formData.password}}" data-field="password" bindinput="handleInput" />
    </view>
  </view>
  <!-- 操作按钮 -->
  <view class="btn-section">
    <button class="login-btn {{isLoading ? 'loading' : ''}}" disabled="{{isLoading}}" bindtap="handleLogin">
      <view wx:if="{{isLoading}}" class="loading-icon"></view>
      {{isLoading ? '登录中...' : '立即登录'}}
    </button>
    <view class="switch-login-type" bindtap="toggleLoginType">
      <text class="switch-text">{{loginType === 'code' ? '切换密码登录' : '切换验证码登录'}}</text>
    </view>
    <view class="register-link" bindtap="goToRegister">
      <text class="link-label">还没有账号？</text>
      <text class="link-action">立即申请入驻</text>
    </view>
  </view>
  <!-- 底部协议 -->
  <view class="footer-agreement">
    <view class="agree-row" bindtap="toggleAgree">
      <view class="checkbox {{isAgreed ? 'checked' : ''}}">
        <view wx:if="{{isAgreed}}" class="check-icon"></view>
      </view>
      <text class="agree-label">同意</text>
      <text class="agree-link" catchtap="navToAgreement">《用户协议》</text>
      <text class="agree-label">和</text>
      <text class="agree-link" catchtap="navToPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>

<!-- 动态注入返回智慧党建飘窗 -->
<global-home-btn />
