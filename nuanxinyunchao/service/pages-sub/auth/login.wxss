.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #efecec;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.safe-area-header {
  width: 100%;
}

.logo-section {
  margin-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-img {
  margin-bottom: 24rpx;
  height: 160rpx;
  width: 160rpx;
}

.title-main {
  font-size: 40rpx;
  font-weight: bold;
  color: #574234;
}

.title-sub {
  font-size: 40rpx;
  font-weight: 500;
  color: #574234;
}

.form-container {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.input-item {
  display: flex;
  align-items: center;
  border-radius: 99rpx;
  background-color: white;
  padding: 28rpx 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

