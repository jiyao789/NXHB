.footer-agreement {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.agree-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #4b4c4cff;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
