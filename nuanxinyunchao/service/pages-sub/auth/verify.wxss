.w-80 { width: 80rpx; }
.h-80 { height: 80rpx; }
.rounded-full { border-radius: 50%; }
.border-2 { border-width: 4rpx; }
.border-white-80 { border-color: rgba(255, 255, 255, 0.8); }
.border-white { border-color: #ffffff; }
.border-solid { border-style: solid; }
.backdrop-blur-sm { backdrop-filter: blur(4px); }
.active-scale-90:active { transform: scale(0.9); }

.-z-10 { z-index: -10; }

.text-left { text-align: left; }

.notice-scroll {
  max-height: 900rpx;
  width: 100%;
}

.close-x {
  color: white;
  font-size: 40rpx;
  font-weight: bold;
}

.reapply-btn {
  background-color: #FF6B00;
  color: white;
  font-size: 30rpx;
