.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #efecec;
  box-sizing: border-box;
}

.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #efecec;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.back-btn:active {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon-back {
  width: 32rpx;
  height: 32rpx;
  border-top: 4rpx solid #333;
  border-left: 4rpx solid #333;
  transform: rotate(-45deg);
  margin-left: 12rpx;
}

.nav-title {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #111827;
  font-weight: bold;
}

.form-view {
  padding: 0 48rpx 80rpx 48rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.tab-switch-container {
  display: flex;
  background-color: #fff;
  border-radius: 99rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #6b7280;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #FF6B00;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0rpx;
  width: 40rpx;
  height: 6rpx;
  background-color: #FF6B00;
  border-radius: 99rpx;
  animation: tabLineIn 0.3s ease-out;
}

@keyframes tabLineIn {
  from { width: 0; opacity: 0; transform: scaleX(0); }
  to { width: 40rpx; opacity: 1; transform: scaleX(1); }
}

.logo-section {
  margin-top: 40rpx;
  margin-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-img {
  margin-bottom: 24rpx;
  height: 160rpx;
  width: 160rpx;
}

.title-main {
  font-size: 40rpx;
  font-weight: bold;
  color: #574234;
}

.title-sub {
  font-size: 40rpx;
  font-weight: 500;
  color: #574234;
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  border-radius: 99rpx;
  background-color: white;
  padding: 28rpx 40rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}

.form-item.orange { border: 2rpx solid #FF6B00; }

.mr-24 { margin-right: 24rpx; }

