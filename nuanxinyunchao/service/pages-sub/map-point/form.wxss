/* 营业时间抽屉样式 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  transition: all 0.3s ease;
}

.drawer-content {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: all 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
  min-height: 650rpx;
}

.drawer-content.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 40rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.drawer-cancel {
  font-size: 30rpx;
  color: #9ca3af;
}

.drawer-confirm {
  font-size: 30rpx;
  color: #ff6b00;
  font-weight: bold;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #111827;
}

.drawer-body {
  padding: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.week-list {
  display: flex;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.week-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 50%;
  transition: all 0.2s;
}

.week-item.active {
  background: #ff6b00;
  color: #fff;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.3);
}

.week-label {
  font-size: 28rpx;
}

.time-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.time-picker {
  flex: 1;
}

.time-box {
  height: 100rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f3f4f6;
}

.time-val {
  font-size: 36rpx;
  font-weight: bold;
  color: #111827;
}

.time-sep {
  width: 40rpx;
  height: 4rpx;
  background: #d1d5db;
}
