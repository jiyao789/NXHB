<view class="page-container" style="background: #F9FAFB; min-height: 100vh; padding-bottom: 200rpx;">
  <view style="padding: 24rpx; display: flex; flex-direction: column; gap: 24rpx;">
    <view wx:for="{{list}}" wx:key="id" style="background: #fff; border-radius: 12rpx; padding: 24rpx; display: flex; align-items: center; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);" bindtap="handleEdit" bindlongpress="handleDelete" data-item="{{item}}">
      <!-- 左侧图标框 -->
      <view style="width: 140rpx; height: 140rpx; background: #F3F4F6; border-radius: 8rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; overflow: hidden;">
        <image wx:if="{{item.images}}" src="{{item.images}}" mode="aspectFill" style="width: 100%; height: 100%;"></image>
        <view wx:else class="icon-shop" style="font-size: 70rpx; color: #D1D5DB;"></view>
      </view>
      <!-- 右侧内容 -->
      <view style="flex: 1; display: flex; flex-direction: column; justify-content: center; overflow: hidden;">
        <view style="font-size: 32rpx; font-weight: bold; color: #111827; margin-bottom: 12rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{item.name}}</view>
        <view style="font-size: 24rpx; color: #6B7280; margin-bottom: 8rpx;">营业时间:{{item.businessHours || '--'}}</view>
        <view style="font-size: 24rpx; color: #6B7280;">咨询电话:{{item.phone || '--'}}</view>
      </view>
    </view>

    <view wx:if="{{list.length === 0 && !loading}}" style="padding: 100rpx 0; display: flex; flex-direction: column; align-items: center; color: #9CA3AF;">
      <view class="i-carbon-box" style="font-size: 80rpx; margin-bottom: 16rpx;"></view>
      <text style="font-size: 28rpx;">暂无点位数据</text>
    </view>
  </view>

  <!-- 底部悬浮新增按钮 -->
  <view style="position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 24rpx 32rpx env(safe-area-inset-bottom); box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05); z-index: 50;">
    <button style="width: 100%; background: #F97316; color: #fff; border-radius: 100rpx; font-size: 32rpx; display: flex; align-items: center; justify-content: center; gap: 16rpx;" bindtap="handleAdd">
      <view class="i-carbon-add" style="font-size: 40rpx;"></view>
      新增点位
    </button>
  </view>
</view>
