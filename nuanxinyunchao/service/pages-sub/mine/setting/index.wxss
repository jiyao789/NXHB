/* 页面背景色 */
page {
  background-color: #efecec;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 固定导航栏 */
.nav-fixed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  background-color: #efecec;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.back-btn {
  position: absolute;
  left: 16rpx;
  height: 64rpx;
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 20;
}

.bg-active {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon-back {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid #111827; /* gray-900 */
  border-left: 4rpx solid #111827;
  transform: rotate(-45deg);
}

.nav-title {
  font-size: 36rpx;
  color: #111827;
  font-weight: bold;
}

.nav-placeholder {
  flex: none;
}

/* 内容区域 */
.main-content {
  padding: 24rpx 0 80rpx 0;
}

/* 白色设置卡片 */
.setting-card {
  margin: 0 32rpx 48rpx 32rpx; /* mx-4 mb-6 */
  background-color: #ffffff;
  border-radius: 24rpx; /* rounded-xl */
  overflow: hidden;
}

/* 图标列表项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  transition: background-color 0.2s;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
}

.item-text {
  font-size: 32rpx; /* text-base */
  color: #1f2937; /* gray-800 */
}

/* 纯文字操作项 */
.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx; /* h-14 */
  width: 100%;
  transition: background-color 0.2s;
}

.action-text {
  font-size: 32rpx;
  color: #1f2937; /* gray-800 */
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: #e5e7eb; /* gray-200 */
  margin: 0 32rpx; /* mx-4 */
}

/* 原生 CSS 绘制右侧箭头 */
.icon-chevron-right {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #d1d5db; /* gray-300 */
  border-right: 4rpx solid #d1d5db;
  transform: rotate(45deg);
}

