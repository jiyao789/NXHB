page {
  background-color: #efecec;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* --- 自定义导航栏 --- */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  background-color: #efecec;
}

.nav-content {
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
}

.back-btn {
  position: absolute;
  left: 8px;
  height: 32px;
  width: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.btn-hover {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon-back {
  width: 10px;
  height: 10px;
  border-top: 2px solid #111827;
  border-left: 2px solid #111827;
  transform: rotate(-45deg);
  margin-left: 4px;
}

.nav-title {
  font-size: 18px;
  color: #111827;
  font-weight: bold;
}

/* --- 内容区域 --- */
.content-wrapper {
  padding: 12px 16px 0;
}

.card-box {
  overflow: hidden;
  border-radius: 12px;
  background-color: #ffffff;
}

.setting-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
}

.item-text-group {
  display: flex;
  flex-direction: column;
}

.item-title {
  font-size: 16px;
  color: #1f2937;
}

.item-desc {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 4px;
}

/* 卡片内部细分割线 */
.absolute-divider {
  position: absolute;
  bottom: 0;
  right: 8px;
  left: 8px;
  height: 1px;
  background-color: #e5e7eb;
  z-index: 20;
}

.hint-text {
  margin-top: 8px;
  padding: 0 4px;
  font-size: 12px;
  color: #9ca3af;
  line-height: 1.4;
}