<view class="page-container">
  
  <view class="nav-fixed" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="back-btn" hover-class="bg-active" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <text class="nav-title">账号安全</text>
    </view>
  </view>
  
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <view class="main-content">
    <view class="security-card">
      
      <view 
        wx:for="{{list}}" 
        wx:key="index" 
        class="list-item" 
        hover-class="bg-active"
        bindtap="handleNav"
        data-path="{{item.path}}"
      >
        <text class="item-title">{{item.title}}</text>
        
        <view class="icon-chevron-right"></view>
        
        <view wx:if="{{index < list.length - 1}}" class="divider-line"></view>
      </view>

    </view>
  </view>

</view>