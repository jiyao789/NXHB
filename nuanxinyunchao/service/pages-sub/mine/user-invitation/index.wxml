<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="nav-fixed" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="back-btn" hover-class="bg-active" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <text class="nav-title">用户注册邀请码</text>
    </view>
  </view>
  
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <view class="main-content">
    <!-- 生成区域 -->
    <view class="create-card">
      <view class="card-title">生成邀请码</view>
      <view class="card-desc">选择用户身份并生成唯一邀请码，用于 C 端用户自主注册。</view>
      
      <view class="input-group">
        <text class="label">选择身份</text>
        <view class="role-picker">
          <view 
            class="role-option {{selectedRole === item.id ? 'active' : ''}}" 
            wx:for="{{roleOptions}}" 
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="selectRole"
          >
            <text class="role-name">{{item.name}}</text>
            <view class="role-check" wx:if="{{selectedRole === item.id}}">✓</view>
          </view>
        </view>
      </view>

      <view class="btn-generate {{!selectedRole ? 'disabled' : ''}}" bindtap="handleGenerate">
        <text>一键生成邀请码</text>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="list-section">
      <view class="section-header">
        <text class="section-title">生成记录</text>
        <view class="refresh-box" bindtap="fetchList">
          <view class="icon-refresh {{isRefreshing ? 'rotating' : ''}}"></view>
          <text>刷新</text>
        </view>
      </view>

      <block wx:if="{{list.length > 0}}">
        <view class="record-item" wx:for="{{list}}" wx:key="id">
          <view class="record-info">
            <view class="name-status">
              <text class="center-name">{{item.rolesName}}</text>
              <view class="status-tag {{item.isUsed ? 'used' : 'unused'}}">
                {{item.isUsed ? '已注册' : '未使用'}}
              </view>
            </view>
            <view class="code-box">
              <text class="code-label">邀请码：</text>
              <text class="code-value">{{item.invitationCode}}</text>
              <view class="btn-copy" bindtap="handleCopy" data-code="{{item.invitationCode}}">复制</view>
            </view>
            <!-- 二维码小图预览 -->
            <view class="qrcode-preview-row">
              <image 
                wx:if="{{item.qrImagePath}}" 
                src="{{item.qrImagePath}}" 
                class="qr-small-img" 
                mode="aspectFit"
              ></image>
              <view wx:else class="qr-small-placeholder"></view>
              <view class="btn-show-qr" bindtap="showQrCode" data-item="{{item}}">查看二维码</view>
            </view>
            <!-- 隐藏的canvas，仅用于离屏绘制 -->
            <canvas 
              type="2d" 
              id="qr-small-{{item.id}}" 
              class="qr-small-canvas-hidden"
              style="width: 80rpx; height: 80rpx;"
            ></canvas>
            <view class="time-box">生成时间：{{item.createTime || '-'}}</view>
            <!-- 已注册的显示查看详情按钮 -->
            <view class="btn-view-detail" wx:if="{{item.isUsed}}" bindtap="showDetail" data-id="{{item.id}}">查看详情</view>
          </view>
          <!-- 只有未使用的才显示删除按钮 -->
          <view class="btn-delete" wx:if="{{!item.isUsed}}" bindtap="handleDelete" data-id="{{item.id}}">
            <view class="icon-delete"></view>
          </view>
        </view>
      </block>
      
      <view class="empty-holder" wx:else>
        <view class="empty-img"></view>
        <text>暂无生成记录</text>
      </view>
    </view>
  </view>

  <!-- 隐藏的大二维码canvas，仅用于离屏绘制 -->
  <canvas 
    wx:if="{{showQrModal}}" 
    type="2d" 
    id="qr-big" 
    class="qr-big-canvas-hidden" 
    style="width: 440rpx; height: 440rpx;"
  ></canvas>

  <!-- 二维码弹窗 -->
  <view class="qr-modal-mask" wx:if="{{showQrModal}}" bindtap="hideQrCode">
    <view class="qr-modal-content" catchtap="">
      <view class="qr-modal-title">注册邀请二维码</view>
      <view class="qr-modal-role">身份：{{qrModalItem.rolesName}}</view>
      <view class="qr-modal-code">邀请码：{{qrModalItem.invitationCode}}</view>
      <view class="qr-canvas-wrap">
        <image 
          wx:if="{{qrBigImagePath}}" 
          src="{{qrBigImagePath}}" 
          class="qr-big-img" 
          mode="aspectFit"
        ></image>
        <view wx:else class="qr-big-loading">生成中...</view>
      </view>
      <view class="qr-modal-tip">用户扫码即可跳转注册页面</view>
      <view class="qr-modal-actions">
        <view class="btn-save-qr" bindtap="saveQrCode">保存到相册</view>
        <view class="btn-close-qr" bindtap="hideQrCode">关闭</view>
      </view>
    </view>
  </view>

  <!-- 注册人详情弹窗 -->
  <view class="detail-modal-mask" wx:if="{{showDetailModal}}" bindtap="hideDetail">
    <view class="detail-modal-content" catchtap="">
      <view class="detail-modal-header">
        <text class="detail-modal-title">注册人详情</text>
        <view class="detail-modal-close" bindtap="hideDetail">✕</view>
      </view>

      <block wx:if="{{detailData && detailData.userInfo}}">
        <view class="detail-section">
          <view class="detail-row">
            <text class="detail-label">姓名</text>
            <text class="detail-value">{{detailData.userInfo.name || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">手机号</text>
            <text class="detail-value">{{detailData.userInfo.phone || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">身份</text>
            <text class="detail-value">{{detailData.rolesName || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">所属网点</text>
            <text class="detail-value">{{detailData.userInfo.siteName || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">商圈范围</text>
            <text class="detail-value">{{detailData.userInfo.businessArea || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">居住地址</text>
            <text class="detail-value">{{detailData.userInfo.address || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">是否党员</text>
            <text class="detail-value">{{detailData.userInfo.isPartyMember ? '是' : '否'}}</text>
          </view>
        </view>

        <!-- 职业证件 -->
        <view class="detail-cert-section">
          <text class="detail-cert-title">职业证件</text>
          <view class="detail-cert-grid">
            <!-- 多图 -->
            <block wx:if="{{detailData.userInfo.certImages && detailData.userInfo.certImages.length > 0}}">
              <image 
                wx:for="{{detailData.userInfo.certImages}}" 
                wx:key="*this" 
                src="{{item}}" 
                class="detail-cert-img" 
                mode="aspectFill"
                bindtap="previewDetailImage" 
                data-url="{{item}}"
              ></image>
            </block>
            <!-- 单图（兼容旧数据） -->
            <block wx:elif="{{detailData.userInfo.certImage}}">
              <image 
                src="{{detailData.userInfo.certImage}}" 
                class="detail-cert-img" 
                mode="aspectFill"
                bindtap="previewDetailImage" 
                data-url="{{detailData.userInfo.certImage}}"
              ></image>
            </block>
            <text wx:else class="detail-cert-empty">暂无证件</text>
          </view>
        </view>
      </block>

      <view wx:else class="detail-empty">
        <text>未找到注册人信息</text>
      </view>

      <view class="detail-modal-footer">
        <view class="btn-detail-close" bindtap="hideDetail">关闭</view>
      </view>
    </view>
  </view>

</view>
