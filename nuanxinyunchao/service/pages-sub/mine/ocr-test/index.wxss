.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
}

/* ========== 导航栏 ========== */
.nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(26, 26, 46, 0.95);
  backdrop-filter: blur(20rpx);
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.bg-active {
  background: rgba(255, 255, 255, 0.1);
}

.icon-back {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.nav-placeholder {
  width: 100%;
}

/* ========== 滚动区域 ========== */
.scroll-area {
  height: calc(100vh);
  box-sizing: border-box;
}

.content-wrapper {
  padding: 24rpx 32rpx;
}

/* ========== 分组标题 ========== */
.section-group {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

/* ========== OCR类型选择 ========== */
.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.type-normal {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.type-active {
  background: linear-gradient(135deg, #e2b04a, #f0c866);
  color: #1a1a2e;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 20rpx rgba(226, 176, 74, 0.4);
}

/* ========== 身份证正反面 ========== */
.side-list {
  display: flex;
  gap: 16rpx;
}

.side-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.side-normal {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.5);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.side-active {
  background: rgba(226, 176, 74, 0.15);
  color: #e2b04a;
  border: 2rpx solid rgba(226, 176, 74, 0.4);
}

/* ========== 图片选择 ========== */
.image-area {
  width: 100%;
  min-height: 360rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.plus-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(226, 176, 74, 0.15);
  color: #e2b04a;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.preview-image {
  width: 100%;
  height: 360rpx;
}

.change-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  padding: 12rpx 0;
}

/* ========== 识别按钮 ========== */
.action-area {
  margin-bottom: 36rpx;
}

.recognize-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #e2b04a, #d4972e);
  color: #1a1a2e;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(226, 176, 74, 0.35);
  transition: all 0.3s ease;
}

.recognize-btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-disabled {
  opacity: 0.5;
}

/* ========== 识别结果 ========== */
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-header .section-title {
  margin-bottom: 0;
}

.copy-btn {
  font-size: 24rpx;
  color: #e2b04a;
  padding: 8rpx 24rpx;
  border: 2rpx solid rgba(226, 176, 74, 0.4);
  border-radius: 24rpx;
}

.result-card {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.result-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.result-row:last-child {
  border-bottom: none;
}

.result-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.45);
}

.result-value {
  flex: 1;
  font-size: 26rpx;
  color: #ffffff;
  word-break: break-all;
}

.result-row-full {
  padding: 14rpx 0;
}

.result-value-full {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.8;
  word-break: break-all;
}

/* ========== JSON展示 ========== */
.json-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.json-title {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 16rpx;
}

.json-content {
  font-size: 22rpx;
  color: #8be9fd;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ========== 底部占位 ========== */
.bottom-placeholder {
  height: 120rpx;
}
