page {
  height: 100vh;
  background-color: #f8f8f8;
}

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.bg-global {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ================= 导航栏 ================= */
.nav-wrapper {
  position: relative;
  z-index: 50;
  flex-shrink: 0;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
}

.back-btn {
  position: absolute;
  left: 8px;
  height: 32px;
  width: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.btn-hover {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon-back {
  width: 10px;
  height: 10px;
  border-top: 2px solid #5b473f;
  border-left: 2px solid #5b473f;
  transform: rotate(-45deg);
  margin-left: 4px;
}

.nav-title {
  font-size: 18px;
  color: #5b473f;
  font-weight: bold;
}

/* ================= Banner ================= */
.rights-banner-box {
  position: relative;
  z-index: 10;
  margin-top: 20rpx;
  padding: 0 40rpx;
  display: flex;
  justify-content: center;
}

.rights-img {
  height: 360rpx;
  width: auto;
}

/* ================= 内容区 ================= */
.main-content {
  position: relative;
  z-index: 20;
  margin-top: -40rpx; /* 与banner重叠一点点以制造层级感 */
  flex: 1;
  display: flex;
  flex-direction: column;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  overflow: hidden;
  padding: 60rpx 40rpx;
}

.content-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
  height: 100%;
  width: 100%;
}

.text-content {
  position: relative;
  z-index: 10;
}

.title-main {
  font-size: 44rpx;
  color: #5b473f;
  line-height: 1.4;
}

.description {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.8;
  text-align: justify;
}

/* ================= 分割线内容 ================= */
.expect-divider {
  margin-top: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.line {
  height: 1rpx;
  width: 100rpx;
  background-color: #5b473f;
}

.expect-text {
  font-size: 28rpx;
  color: #f97316; /* 橙色 */
  font-weight: 500;
}

/* ================= 权益列表 ================= */
.benefit-list-container {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 60rpx;
}

.benefit-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.benefit-tag {
  position: absolute;
  top: -20rpx;
  left: 32rpx;
  background-color: #FF7D00;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.benefit-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.benefit-items {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.benefit-item text {
  font-size: 28rpx;
  color: #666666;
}

.icon-check {
  width: 32rpx;
  height: 32rpx;
  background-color: #3d3d3d;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-check::after {
  content: '';
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}
