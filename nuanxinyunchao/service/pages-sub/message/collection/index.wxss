.page-container {
  height: 100vh;
  background-color: #f5f6f7ff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  background-color: #f5f6f7ff;
  position: relative;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #333;
  border-left: 4rpx solid #333;
  transform: rotate(-45deg);
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 分类 Tab 栏 */
.tab-bar {
  display: flex;
  background-color: #f5f6f7ff;
  padding: 0 40rpx;
  height: 80rpx;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 100%;
}

.tab-text {
  font-size: 30rpx;
  color: #666666;
  transition: all 0.2s;
}

.tab-text.active {
  color: #ff7d00;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  background-color: #ff7d00;
  border-radius: 4rpx;
}

/* 列表区域 */
.scroll-wrapper {
  flex: 1;
  height: 0;
}

.list-container {
  padding: 24rpx 32rpx;
}

/* 街道用户收藏项 (采用点赞页最美样式) */
.like-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

/* 并排卡片容器 */
.media-card-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.media-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  margin-right: 20rpx;
}

.street-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f0f0f0;
}

.user-name-box {
  display: flex;
  flex-direction: column;
}

.street-nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.action-time-row {
  display: flex;
  align-items: center;
}

.street-action {
  font-size: 28rpx;
  color: #333;
  margin-right: 12rpx;
}

.street-date {
  font-size: 26rpx;
  color: #bbbbbb;
}

/* 媒体右侧预览 (封面) */
.media-right {
  position: relative;
  width: 140rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.media-cover {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

/* 视频播放图标 */
.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon::after {
  content: "";
  display: block;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid #333;
  margin-left: 4rpx;
}

/* 原有收藏大卡片 (商户专用) */
.collection-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action, .date {
  font-size: 24rpx;
  color: #999999;
}

/* 优惠券票据卡片 */
.ticket-card {
  display: flex;
  align-items: center;
  height: 200rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  position: relative;
  -webkit-mask-image: 
    radial-gradient(circle at 200rpx 0, transparent 20rpx, black 0),
    radial-gradient(circle at 200rpx 200rpx, transparent 20rpx, black 0);
  -webkit-mask-composite: source-in;
  mask-image: 
    radial-gradient(circle at 200rpx 0, transparent 20rpx, black 0),
    radial-gradient(circle at 200rpx 200rpx, transparent 20rpx, black 0);
  mask-composite: intersect; 
}

.ticket-container {
  padding: 2rpx;
  filter: drop-shadow(0 0 1rpx #e0e0e0) drop-shadow(0 0 1rpx #e0e0e0);
}

.ticket-left {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  padding: 16rpx;
  box-sizing: border-box;
}

.coupon-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.ticket-divider {
  width: 2rpx;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dashed-line {
  flex: 1;
  width: 0;
  border-left: 2rpx dashed #eeeeee;
}

.ticket-right {
  flex: 1;
  height: 100%;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  position: relative;
}

.coupon-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 20rpx;
  color: #999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.store-name {
  font-size: 20rpx;
  color: #999999;
}

.exchange-btn {
  align-self: center;
  flex-shrink: 0;
  background: linear-gradient(90deg, #ff8c00, #ff4500);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 69, 0, 0.2);
}

.safe-bottom {
  height: 100rpx;
}
