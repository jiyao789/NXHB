.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f8fa;
  overflow: hidden;
}

/* 固定导航栏 */
.nav-fixed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  background-color: #f7f8fa;
}

.nav-content {
  position: relative;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.back-btn {
  position: absolute;
  left: 32rpx;
  height: 64rpx;
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-active {
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
}

.icon-back {
  width: 22rpx;
  height: 22rpx;
  border-top: 4rpx solid #333333;
  border-left: 4rpx solid #333333;
  transform: rotate(-45deg);
}

.nav-title {
  font-size: 34rpx;
  color: #333333;
  font-weight: 500;
}

.nav-spacer {
  flex: none;
}

/* 滚动区域与列表 */
.scroll-area {
  flex: 1;
  height: 0;
}

.list-inner {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.msg-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.card-subheader {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
  margin-right: 20rpx;
}

.card-time {
  font-size: 26rpx;
  color: #999999;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999px;
  font-weight: 500;
}

.status-verified {
  background-color: #F0F9EB;
  color: #67C23A;
}

.status-cancelled {
  background-color: #F4F4F5;
  color: #A1A1AA;
}

/* 街道：核销样式 */
.redemption-info {
  display: flex;
  justify-content: space-between;
}

.info-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-line {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.4;
}

.small-preview-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  margin-left: 20rpx;
}

/* 街道：优惠券样式 */
.coupon-preview-wrapper {
  margin-top: 10rpx;
}

.mini-coupon {
  display: flex;
  height: 170rpx;
  background-color: #fef4f4; /* 极浅粉背景 */
  border-radius: 24rpx; /* 加大圆角 */
  overflow: hidden;
  position: relative;
}

.coupon-left {
  width: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fa5151; /* 微信红 */
  background-color: #fdf1f1;
  position: relative;
  border-radius: 24rpx 0 0 24rpx;
}

/* 虚线分割线及物理凹槽 */
.coupon-left::after {
  content: '';
  position: absolute;
  right: 0;
  top: 24rpx;
  bottom: 24rpx;
  border-right: 2rpx dashed #ffcfcf;
}

/* 上下圆形凹槽 */
.mini-coupon::before, .mini-coupon::after {
  content: '';
  position: absolute;
  left: 178rpx; /* (left宽度190 - 凹槽半径12) */
  width: 24rpx;
  height: 24rpx;
  background-color: #FFFFFF; /* 匹配 .msg-card 的白背景 */
  border-radius: 50%;
  z-index: 5;
}

.mini-coupon::before {
  top: -12rpx;
}

.mini-coupon::after {
  bottom: -12rpx;
}

.c-val {
  font-size: 24rpx;
  font-weight: 500;
  display: flex;
  align-items: baseline;
}

.c-num {
  font-size: 56rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.c-sub {
  font-size: 22rpx;
  margin-top: 2rpx;
  opacity: 0.9;
}

.coupon-right {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.c-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.c-term, .c-desc {
  font-size: 24rpx;
  color: #fa5151;
  margin-bottom: 6rpx;
}

.c-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #fa5151;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-bottom-left-radius: 20rpx;
}

/* 商户普通行 (已弃用，但保留基色) */
.info-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.info-label {
  width: 150rpx;
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 统一页脚 */
.card-footer {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f3f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #7d7d7d;
  font-size: 28rpx;
}

.icon-arrow-next {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #b2b2b2;
  border-right: 3rpx solid #b2b2b2;
  transform: rotate(45deg);
}

.bottom-padding {
  height: 48rpx;
}
