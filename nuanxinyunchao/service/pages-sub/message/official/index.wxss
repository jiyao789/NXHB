.page-container {
  height: 100vh;
  background-color: #f7f8fa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  background-color: #f7f8fa;
  position: relative;
  z-index: 100;
  flex: none;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #333;
  border-left: 4rpx solid #333;
  transform: rotate(-45deg);
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

/* 滚动区域 */
.scroll-wrapper {
  flex: 1;
  height: 0;
}

.list-container {
  padding: 24rpx 32rpx;
}

/* 卡片样式 */
.card-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.card-item:active {
  opacity: 0.9;
}

.card-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.date {
  font-size: 24rpx;
  color: #999999;
}

.card-body {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.content-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: justify;
}

.content-text.with-img {
  margin-right: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
}

.content-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.card-footer {
  border-top: 2rpx solid #f2f2f2;
  padding-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-text {
  font-size: 28rpx;
  color: #333333;
}

.icon-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #999;
  border-right: 3rpx solid #999;
  transform: rotate(45deg);
}

.safe-bottom {
  height: 80rpx;
}

/* 加载更多提示 */
.load-more-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #bbbbbb;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-hint {
  font-size: 28rpx;
  color: #999999;
}

