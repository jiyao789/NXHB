.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  /* 总高度 = 内容区域(100rpx) + 底部安全区 */
  height: calc(100rpx + env(safe-area-inset-bottom));
  background: white;
  display: flex;
  /* 内容对齐顶部，安全区由 padding 手动指定 */
  align-items: flex-start;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10001;
  box-sizing: border-box;
}

.tab-bar-border {
  background-color: rgba(0, 0, 0, 0.05);
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1px;
  transform: scaleY(0.5);
}

.tab-bar-item {
  flex: 1;
  height: 100rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.tab-bar-item image {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-bar-item view {
  font-size: 20rpx;
}

/* 凸起样式 */
.tab-bar-item.bulge {
  position: relative;
  z-index: 10002;
}

.bulge-wrapper {
  position: absolute;
  top: -50rpx;
  width: 150rpx;
  height: 150rpx;
  background-color: #FFD700;
  border-radius: 50%;
  border: 8rpx solid white;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 -4rpx 16rpx rgba(255, 215, 0, 0.4);
}

.bulge-wrapper image {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 0;
}

.bulge-text {
  margin-top: 72rpx;
}
