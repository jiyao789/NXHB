<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view wx:for="{{list}}" wx:key="index" class="tab-bar-item {{item.isBulge ? 'bulge' : ''}}" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <block wx:if="{{item.isBulge}}">
      <view class="bulge-wrapper">
        <image src="{{item.iconPath}}"></image>
      </view>
      <view class="bulge-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
    </block>
    <block wx:else>
      <image src="{{selected === index ? item.selectedIconPath : item.iconPath}}"></image>
      <view style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
    </block>
  </view>
</view>
