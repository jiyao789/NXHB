.relative {
  position: relative;
  display: inline-block;
}

.header-logo-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 14rpx;
  margin-left: -14rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.header-logo-box:active {
  background-color: rgba(0, 0, 0, 0.06);
}

.header-logo-img {
  height: 48rpx;
  width: 48rpx;
  flex-shrink: 0;
}

.header-title-img {
  height: 32rpx;
  width: 128rpx;
  flex-shrink: 0;
}

.arrow-icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid rgba(80, 50, 20, 0.7);
  margin-left: 4rpx;
  transition: transform 0.25s ease;
}

.rotate-180 {
  transform: rotate(180deg);
}

/* 全屏遮罩防止点透 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99998;
  background: transparent;
}

/* 下拉菜单 */
.dropdown-menu {
  position: absolute;
  top: 68rpx;
  left: 12rpx;
  z-index: 99999;
  width: 260rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.14), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  padding: 10rpx 0;
  animation: dropdownFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes dropdownFadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 顶部小三角气泡箭头 */
.dropdown-triangle {
  position: absolute;
  top: -12rpx;
  left: 36rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #ffffff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  gap: 16rpx;
  transition: background-color 0.15s ease;
}

.menu-item-hover {
  background-color: #f7f7f7;
}

.menu-icon {
  width: 34rpx;
  height: 34rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  flex-shrink: 0;
}

