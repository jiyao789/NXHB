.page-container {
  position: relative;
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.nav-bar-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
}

.nav-bar-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.org-logo-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #f3f4f6;
  background-color: #f9fafb;
}

.org-name-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-container {
  width: 100%;
}

.detail-swiper {
  width: 100%;
  height: 750rpx;
  background-color: #f3f4f6;
}

.media-item-detail {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-fallback {
  width: 100%;
  display: block;
}

.content-section {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.detail-body {
  font-size: 30rpx;
  color: #4b5563;
  line-height: 1.6;
  text-align: justify;
  margin-bottom: 32rpx;
  white-space: pre-wrap;
}

.meta-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.time-text {
  font-size: 24rpx;
  color: #9ca3af;
}

.footer-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.primary-submit-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FFD700;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #000000;
  box-shadow: 0 8rpx 16rpx rgba(255, 215, 0, 0.2);
}

.btn-hover-effect {
  opacity: 0.9;
  transform: scale(0.98);
}

.icon-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #111827;
  border-left: 4rpx solid #111827;
  transform: rotate(-45deg);
  margin-left: 8rpx;
}

.pb-safe {
  padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx);
}

.bg-white {
  background-color: #ffffff !important;
}

.official-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  color: transparent;
}
