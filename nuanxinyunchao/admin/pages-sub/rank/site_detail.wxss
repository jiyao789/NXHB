.service-modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 数据展示框：浅灰背景、圆角 */
.service-modal-stat-box {
  width: 95%;
  background: #f4f6f8;
  border-radius: 24rpx;
  padding: 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.service-modal-stat-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #8a9ab0;
  text-align: center;
}

/* 数字和单位在同一行，数字大、单位小 */
.service-modal-stat-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.service-modal-stat-num {
  font-size: 80rpx;
  font-weight: 900;
  color: #ec5b13;
  line-height: 1;
}

.service-modal-stat-unit {
  font-size: 32rpx;
  font-weight: bold;
  color: #ec5b13;
  line-height: 1;
}

/* 确认按钮：实色橙、全宽圆角 */
.service-modal-btn {
  width: 100%;
  background: #ec5b13;
  border-radius: 24rpx;
  padding: 36rpx 0;
  text-align: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 32rpx rgba(236, 91, 19, 0.25);
}

.service-modal-btn:active {
  opacity: 0.85;
}