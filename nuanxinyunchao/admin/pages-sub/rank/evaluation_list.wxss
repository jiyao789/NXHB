page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

::-webkit-scrollbar {
  display: none;
  width: 0 !important;
  height: 0 !important;
  -webkit-appearance: none;
  background: transparent;
}

/* 基础布局 */
.flex {
  display: flex;
}

.flex-row {
  flex-direction: row;
}

.flex-col {
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.shrink-0 {
  flex-shrink: 0;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

.inset-0 {
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.sticky {
  position: sticky;
}

.top-0 {
  top: 0;
}

.top-full {
  top: 100%;
}

.left-0 {
  left: 0;
}

.z-10 {
  z-index: 10;
}

.z-40 {
  z-index: 40;
}

.z-50 {
  z-index: 50;
}

.overflow-hidden {
  overflow: hidden;
}

.min-w-0 {
  min-width: 0;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.h-screen {
  height: 100vh;
}

.max-w-2xl {
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
}

.size-4 {
  width: 32rpx;
  height: 32rpx;
}

.size-5 {
  width: 40rpx;
  height: 40rpx;
}

.size-10 {
  width: 80rpx;
  height: 80rpx;
}

.size-12 {
  width: 96rpx;
  height: 96rpx;
}

.h-9 {
  height: 72rpx;
}

.h-10 {
  height: 80rpx;
}

.box-border {
  box-sizing: border-box;
}

/* 搜索栏动画 */
.search-container {
  height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: transparent;
}

.search-container.show {
  height: 100rpx;
  opacity: 1;
  padding-bottom: 8rpx;
}

.search-bar-inner {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #f1f5f9;
  border-radius: 24rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 12rpx 0 rgba(0, 0, 0, 0.02);
}

/* 筛选气泡 */
.dropdown-bubble {
  min-width: 240rpx;
  max-width: 320rpx;
  transform: translateY(10rpx);
}

.bubble-arrow {
  position: absolute;
  top: -12rpx;
  left: 30rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #ffffff;
  z-index: 51;
}

/* 边距与间距 */
