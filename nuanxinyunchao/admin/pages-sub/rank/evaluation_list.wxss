}

/* 边框、圆角与阴影 */
.border {
  border-width: 1rpx;
  border-style: solid;
  border-color: #e2e8f0;
}

.border-t {
  border-top-width: 1rpx;
  border-top-style: solid;
}

.border-b {
  border-bottom-width: 1rpx;
  border-bottom-style: solid;
}

.border-slate-50 {
  border-color: #f8fafc;
}

.border-slate-100 {
  border-color: #f1f5f9;
}

.border-slate-200 {
  border-color: #e2e8f0;
}

.border-primary-20 {
  border-color: rgba(236, 91, 19, 0.2);
}

.rounded-full {
  border-radius: 9999rpx;
}

.rounded-xl {
  border-radius: 24rpx;
}

.rounded-2xl {
  border-radius: 32rpx;
}

.rounded {
  border-radius: 8rpx;
}

.shadow-sm {
  box-shadow: 0 4rpx 12rpx 0 rgba(0, 0, 0, 0.03);
}

.shadow-lg {
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1);
}

.shadow-xl {
  box-shadow: 0 20rpx 25rpx -5rpx rgba(0, 0, 0, 0.1), 0 10rpx 10rpx -5rpx rgba(0, 0, 0, 0.04);
}

/* 变换与过渡 */
.object-cover {
  object-fit: cover;
}

.scale-85 {
  transform: scale(0.85);
}

.origin-left {
  transform-origin: left;
}

.active-scale:active {
  transform: scale(0.95);
}

.active-scale-sm:active {
  transform: scale(0.98);
}

.transition-all {
  transition: all 0.25s ease;
}

