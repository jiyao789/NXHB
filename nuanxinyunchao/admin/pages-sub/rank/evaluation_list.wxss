/* ================== 全局背景地图与导航 ================== */
.bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: -1;
}

.custom-nav { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 0 32rpx; 
  padding-bottom: 20rpx; 
  transition: background-color 0.3s ease; 
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  z-index: 999; 
  box-sizing: border-box; 
}
.nav-left, .nav-right { width: 80rpx; height: 80rpx; display: flex; align-items: center; } 
.nav-right { justify-content: flex-end; }
.nav-title { font-size: 34rpx; font-weight: bold; color: #0f172a; flex: 1; text-align: center; }

.filter-bar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.filter-scroll {
  min-width: 0;
}

.filter-search-btn {
  display: flex;
  align-items: center;
}

.comment-preview {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-mask {
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
}

.detail-panel {
  max-height: 70vh;
  overflow-y: auto;
}

.z-60 {
  z-index: 1000;
}

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}