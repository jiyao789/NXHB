.page-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 30rpx;
  box-sizing: border-box;
}

.list-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.list-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  transition: all 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.item-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff8e1;
  color: #ff9800;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.item-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  margin-right: 20rpx;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status-gray {
  background: #f5f5f5;
  color: #999999;
}

.item-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.item-info text {
  margin-left: 8rpx;
  flex: 1;
}

.mt-1 {
  margin-top: 8rpx;
}

.truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.active-scale-light:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.icon-xs {
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  color: #cccccc;
}

.icon-empty {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}