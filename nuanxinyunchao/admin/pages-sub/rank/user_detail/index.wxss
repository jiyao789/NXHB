page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ================== 全局背景地图与导航 ================== */
.bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: -1;
}

.custom-nav { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 0 32rpx; 
  padding-bottom: 20rpx; 
  transition: background-color 0.3s ease; 
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  z-index: 999; 
  box-sizing: border-box; 
}
.nav-left, .nav-right { width: 80rpx; height: 80rpx; display: flex; align-items: center; } 
.nav-right { justify-content: flex-end; }
.nav-back, .nav-right {
  width: 80rpx; height: 80rpx; background: rgba(255, 255, 255, 0.8);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.nav-title { font-size: 34rpx; font-weight: bold; color: #0f172a; flex: 1; text-align: center; }

/* ================== 主体滚动区 ================== */
.main-scroll { flex: 1; height: 100%; width: 100%; }
.content-padding { padding: 32rpx 32rpx 64rpx; display: flex; flex-direction: column; gap: 48rpx; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ================== 1. 个人资料卡片 ================== */
.profile-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  border: 2rpx solid #f1f5f9;
}
.avatar-wrap { position: relative; margin-bottom: 32rpx; }
.avatar-img {
  width: 192rpx; height: 192rpx; border-radius: 50%; object-fit: cover;
  border: 8rpx solid #f8fafc; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.verified-badge {
  position: absolute; bottom: 0; right: 0; background: #ec5b13; padding: 6rpx;
  border-radius: 50%; border: 4rpx solid #ffffff; display: flex; align-items: center; justify-content: center;
}
.user-name { font-size: 48rpx; font-weight: bold; color: #0f172a; margin-bottom: 8rpx; }
.user-contact { font-size: 28rpx; color: #64748b; font-weight: 500; margin-bottom: 32rpx; }
.user-points { font-size: 28rpx; font-weight: bold; color: #ec5b13; margin-bottom: 32rpx; }

.tags-row { display: flex; gap: 16rpx; }
.tag-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 4rpx 20rpx; border-radius: 99rpx; font-size: 20rpx; font-weight: bold;
}
.tag-primary { background: rgba(236, 91, 19, 0.05); color: #ec5b13; border: 2rpx solid rgba(236, 91, 19, 0.1); }
.tag-warning { background: #fffbeb; color: #d97706; border: 2rpx solid #fef3c7; }

/* ================== 列表通用区块 ================== */
.section-wrap { display: flex; flex-direction: column; gap: 24rpx; }
.section-header { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx; }
.section-title { font-size: 24rpx; font-weight: 600; color: #ec5b13; letter-spacing: 2rpx; text-transform: uppercase; }
.section-more { display: flex; align-items: center; font-size: 24rpx; font-weight: bold; color: #94a3b8; }

.list-card {
  background: #ffffff; border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); border: 2rpx solid #f1f5f9;
}
.list-item {
  display: flex; align-items: center; gap: 32rpx; padding: 32rpx;
  border-bottom: 2rpx solid #f8fafc;
}
.list-item:last-child { border-bottom: none; }
.item-icon-wrap {
  flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #f8fafc; display: flex; align-items: center; justify-content: center;
}
.item-content { flex: 1; min-width: 0; }
.item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4rpx; }
.item-title { font-size: 28rpx; font-weight: bold; color: #0f172a; flex: 1; margin-right: 16rpx; }
.status-tag { font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: bold; flex-shrink: 0; }
.status-gray { background: #f1f5f9; color: #64748b; }
.status-green { background: #dcfce7; color: #16a34a; }

.item-info { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: #64748b; }
.mt-1 { margin-top: 8rpx; color: #94a3b8; }

/* ================== 优惠券卡片 ================== */
.coupon-list { display: flex; flex-direction: column; gap: 32rpx; }
.coupon-card {
  background: #ffffff; border-radius: 24rpx; padding: 32rpx; position: relative; overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); border: 2rpx solid #f1f5f9;
  display: flex; flex-direction: column; gap: 24rpx;
}
.coupon-border { position: absolute; top: 0; left: 0; width: 8rpx; height: 100%; }
.bg-primary-light { background: rgba(236, 91, 19, 0.4); }
.bg-blue-light { background: rgba(59, 130, 246, 0.4); }

.coupon-top { display: flex; justify-content: space-between; align-items: flex-start; padding-left: 16rpx; }
.coupon-tag { font-size: 20rpx; font-weight: bold; letter-spacing: 2rpx; margin-bottom: 8rpx; }
.text-primary { color: #ec5b13; }
.text-blue { color: #3b82f6; }
.coupon-shop { font-size: 28rpx; font-weight: bold; color: #0f172a; }
.coupon-icon-box { background: #f8fafc; padding: 16rpx; border-radius: 16rpx; display: flex; }

.coupon-mid {
  background: #f8fafc; border-radius: 16rpx; padding: 16rpx; margin-left: 16rpx;
  display: flex; justify-content: space-between; align-items: center;
}
.mid-label { font-size: 20rpx; color: #64748b; }
.mid-value { font-size: 24rpx; font-weight: bold; }

.coupon-bottom { display: flex; align-items: center; gap: 8rpx; font-size: 18rpx; color: #94a3b8; margin-left: 16rpx; }

/* ================== 交互与图标 (SVG Base64) ================== */
.active-scale:active { transform: scale(0.96); opacity: 0.8; transition: all 0.1s; }
.active-scale-light:active { background-color: #f8fafc; transition: all 0.1s; }

.icon-xs { width: 24rpx; height: 24rpx; }
.icon-sm { width: 28rpx; height: 28rpx; }

/* 通用图标样式类 */
[class^="i-"] {
  width: 40rpx; height: 40rpx; background-size: contain; background-repeat: no-repeat; background-position: center;
}

