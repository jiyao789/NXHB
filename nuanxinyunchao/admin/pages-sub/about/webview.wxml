<view class="min-h-screen flex flex-col bg-white">
  <view class="fixed left-0 right-0 top-0 z-50 bg-white" style="padding-top: {{safeAreaTop}}px;">
    <view class="relative h-11 flex items-center justify-center px-4">
      <view class="absolute left-2 h-8 w-8 flex items-center justify-center rounded-full" hover-class="bg-black-5" bindtap="handleBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900"></view>
      </view>
      <text class="text-lg text-gray-900 font-bold">{{ pageConfig.title }}</text>
    </view>
  </view>
  
  <view style="height: {{safeAreaTop + 44}}px;"></view>

  <scroll-view scroll-y class="flex-1 w-full">
    <view class="px-5 pt-6 pb-12 box-border w-full">
      <view class="mb-8 flex flex-col items-center">
        <text class="text-2xl font-bold text-gray-900 mb-3">{{ pageConfig.title }}</text>
        <view class="flex justify-center items-center gap-3 text-xs text-gray-400">
          <text>版本：{{ pageConfig.version }}</text>
          <view class="w-1px h-2 bg-gray-200"></view>
          <text>更新日期：{{ pageConfig.date }}</text>
        </view>
      </view>

      <view class="protocol-rich-text">
        <rich-text nodes="{{pageConfig.content}}"></rich-text>
      </view>
    </view>
  </scroll-view>
</view>
