/* ================== 交互特效 ================== */
.active-scale:active { transform: scale(0.95); opacity: 0.8; transition: all 0.1s; }
.active-scale-sm:active { transform: scale(0.97); transition: all 0.1s; }
.active-scale-light:active { background-color: #f8fafc; transition: all 0.1s; }
