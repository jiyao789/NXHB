page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Public Sans', -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ================== 全局背景地图与导航 ================== */
.bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: -1;
}

.custom-nav { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 0 32rpx; 
  padding-bottom: 20rpx; 
  transition: background-color 0.3s ease; 
  position: fixed; 
  top: 0; 
  left: 0; 
  width: 100%; 
  z-index: 999; 
  box-sizing: border-box; 
}
.nav-left, .nav-right { width: 80rpx; height: 80rpx; display: flex; align-items: center; } 
.nav-right { justify-content: flex-end; }
.nav-back, .nav-right {
  width: 80rpx; height: 80rpx; background: rgba(255, 255, 255, 0.8);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}
.nav-title { font-size: 34rpx; font-weight: bold; color: #0f172a; flex: 1; text-align: center; }

/* ================== 主体滚动与布局 ================== */
.main-scroll { flex: 1; height: 100%; width: 100%; }
.content-padding { padding: 32rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

/* ================== 1. 统计卡片 ================== */
.stats-card {
  background: #ffffff; border-radius: 24rpx; padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); border: 2rpx solid #f1f5f9;
  margin-bottom: 48rpx; display: flex; flex-direction: column; gap: 32rpx;
}
.stats-header { display: flex; justify-content: space-between; align-items: flex-start; }
.stats-label { font-size: 24rpx; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 2rpx; }
.stats-total { font-size: 60rpx; font-weight: bold; color: #0f172a; line-height: 1.2; margin-top: 8rpx; }
.unit { font-size: 24rpx; font-weight: normal; color: #94a3b8; }
.icon-wrap { background: rgba(236, 91, 19, 0.1); padding: 20rpx; border-radius: 24rpx; display: flex; }

.badge-trend {
  display: inline-flex; align-items: center; gap: 4rpx;
  background: rgba(236, 91, 19, 0.05); color: #ec5b13;
  font-size: 20rpx; font-weight: bold; padding: 4rpx 16rpx;
  border-radius: 99rpx; border: 2rpx solid rgba(236, 91, 19, 0.1);
}

/* ================== 2. 横向Tab ================== */
.tab-scroll { width: 100%; height: 80rpx; margin-bottom: 24rpx; }
.tab-flex { display: flex; align-items: center; gap: 16rpx; height: 100%; padding-bottom: 8rpx; }
.tab-item {
  flex-shrink: 0; padding: 12rpx 32rpx; background: #ffffff; color: #64748b;
  font-size: 24rpx; font-weight: 600; border-radius: 99rpx;
  border: 2rpx solid #f1f5f9; transition: all 0.2s;
}
.tab-active {
  background: #ec5b13; color: #ffffff; border-color: #ec5b13;
  box-shadow: 0 4rpx 12rpx rgba(236, 91, 19, 0.2);
}

/* ================== 3. 人员列表 ================== */
.section-title {
  font-size: 24rpx; font-weight: 600; color: #ec5b13;
  text-transform: uppercase; letter-spacing: 2rpx; margin-bottom: 24rpx; padding-left: 8rpx;
}
.list-card {
  background: #ffffff; border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02); border: 2rpx solid #f1f5f9;
}
.empty-state { text-align: center; padding: 64rpx 0; font-size: 28rpx; color: #94a3b8; }

.list-item {
  display: flex; align-items: center; gap: 32rpx;
  padding: 32rpx; border-bottom: 2rpx solid rgba(241, 245, 249, 0.8);
}
.list-item:last-child { border-bottom: none; }

.avatar-wrap { width: 80rpx; height: 80rpx; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: #f8fafc; }
.avatar { width: 100%; height: 100%; }

.item-content { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.name-box { display: flex; align-items: center; gap: 16rpx; margin-bottom: 4rpx; }
.user-name { font-size: 28rpx; font-weight: bold; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 党员标签 */
.tag-party {
  display: inline-flex; align-items: center; gap: 4rpx;
  background: rgba(186, 26, 26, 0.05); color: #ba1a1a;
  font-size: 18rpx; font-weight: bold; padding: 2rpx 12rpx;
  border-radius: 6rpx; border: 2rpx solid rgba(186, 26, 26, 0.1);
  text-transform: uppercase; letter-spacing: 1rpx; flex-shrink: 0;
}

.user-role { font-size: 20rpx; font-weight: 500; color: #64748b; margin-bottom: 8rpx; }
.user-phone { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: #94a3b8; font-family: 'Inter', sans-serif; }

/* ================== 图标系统 (统一规格) ================== */
[class^="i-"] { display: inline-block; background-size: contain; background-repeat: no-repeat; background-position: center; flex-shrink: 0; }

/* 尺寸分配 */
.i-back, .i-search { width: 44rpx; height: 44rpx; }
.i-group { width: 48rpx; height: 48rpx; }
.i-trending-up { width: 24rpx; height: 24rpx; }
.i-star-fill { width: 20rpx; height: 20rpx; }
.i-call { width: 24rpx; height: 24rpx; }
.i-chevron-right { width: 36rpx; height: 36rpx; }

