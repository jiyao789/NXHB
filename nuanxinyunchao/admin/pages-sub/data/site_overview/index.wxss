.active-scale:active { transform: scale(0.92); opacity: 0.7; transition: all 0.15s; }
.active-scale-light:active { transform: scale(0.96); transition: all 0.15s; }

.custom-callout { position: relative; display: block; width: 80rpx; height: 90rpx; }
.callout-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
.callout-content {
  position: absolute; top: 0; left: 0; width: 100%; height: 70rpx; z-index: 2;
  display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 4px;
}
.bubble-icon { width: 24rpx; height: 24rpx; margin-bottom: 2rpx; }
.bubble-text {
  color: #ffffff; font-size: 16rpx; font-weight: bold; line-height: 1; text-align: center;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 90%;
}
