
/* ==== 全局通用样式 (从 User 端完整迁移) ==== */

/* 布局 (Flexbox) */
.flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-2 { flex: 2; }
.flex-3 { flex: 3; }
.flex-shrink-0 { flex-shrink: 0; }
.items-start { align-items: flex-start; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.justify-start { justify-content: flex-start; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }

/* 间距 Gap (基准 8rpx) */
.gap-1 { gap: 8rpx; }
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }
.gap-4 { gap: 32rpx; }
.gap-5 { gap: 40rpx; }
.gap-6 { gap: 48rpx; }
.gap-8 { gap: 64rpx; }

/* 外边距 Margin */
.m-2 { margin: 16rpx; }
.m-3 { margin: 24rpx; }
.m-4 { margin: 32rpx; }
.mx-auto { margin-left: auto; margin-right: auto; }
.my-2 { margin-top: 16rpx; margin-bottom: 16rpx; }
.my-3 { margin-top: 24rpx; margin-bottom: 24rpx; }
.my-4 { margin-top: 32rpx; margin-bottom: 32rpx; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mt-8 { margin-top: 64rpx; }
.mt-24 { margin-top: 192rpx; }
.-mt-6 { margin-top: -48rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-6 { margin-bottom: 48rpx; }
.mb-8 { margin-bottom: 64rpx; }
.mb-10 { margin-bottom: 80rpx; }
.ml-1 { margin-left: 8rpx; }
.ml-2 { margin-left: 16rpx; }
.ml-3 { margin-left: 24rpx; }
.ml-4 { margin-left: 32rpx; }
.ml-6 { margin-left: 48rpx; }
.ml-8 { margin-left: 64rpx; }
.ml-auto { margin-left: auto; }
.mr-1 { margin-right: 8rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }
.mr-4 { margin-right: 32rpx; }
.mx-3 { margin-left: 24rpx; margin-right: 24rpx; }
.mx-4 { margin-left: 32rpx; margin-right: 32rpx; }

/* 内边距 Padding */
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.p-5 { padding: 40rpx; }
.p-6 { padding: 48rpx; }
.px-2 { padding-left: 16rpx; padding-right: 16rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-5 { padding-left: 40rpx; padding-right: 40rpx; }
.px-6 { padding-left: 48rpx; padding-right: 48rpx; }
.px-10 { padding-left: 80rpx; padding-right: 80rpx; }
.py-1 { padding-top: 8rpx; padding-bottom: 8rpx; }
.py-1-5 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-2 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.py-5 { padding-top: 40rpx; padding-bottom: 40rpx; }
.py-6 { padding-top: 48rpx; padding-bottom: 48rpx; }
.pt-2 { padding-top: 16rpx; }
.pt-3 { padding-top: 24rpx; }
.pt-4 { padding-top: 32rpx; }
.pt-12 { padding-top: 96rpx; }
.pb-2 { padding-bottom: 16rpx; }
.pb-3 { padding-bottom: 24rpx; }
.pb-4 { padding-bottom: 32rpx; }
.pb-20 { padding-bottom: 160rpx; }
.pb-24 { padding-bottom: 192rpx; }
.pb-28 { padding-bottom: 224rpx; }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
.pt-safe { padding-top: env(safe-area-inset-top); }

/* 宽高 Sizing */
.w-full { width: 100%; }
.h-full { height: 100%; }
.w-screen { width: 100vw; }
.h-screen { height: 100vh; }
.min-h-screen { min-height: 100vh; }
.w-4 { width: 32rpx; }
.w-6 { width: 48rpx; }
.w-8 { width: 64rpx; }
.w-10 { width: 80rpx; }
.w-12 { width: 96rpx; }
.w-16 { width: 128rpx; }
.h-4 { height: 32rpx; }
.h-6 { height: 48rpx; }
.h-8 { height: 64rpx; }
.h-10 { height: 80rpx; }
.h-12 { height: 96rpx; }
.h-16 { height: 128rpx; }

/* 排版 Typography */
.text-xs { font-size: 24rpx; }
.text-sm { font-size: 28rpx; }
.text-base { font-size: 32rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }
.text-4xl { font-size: 72rpx; }
.font-bold { font-weight: bold; }
.font-medium { font-weight: 500; }
.text-center { text-align: center; }
.whitespace-nowrap { white-space: nowrap; }
.truncate { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.leading-none { line-height: 1; }
.leading-tight { line-height: 1.25; }

/* 颜色 Colors */
.text-white { color: #ffffff; }
.text-black { color: #000000; }
.text-gray-300 { color: #d1d5db; }
.text-gray-400 { color: #9ca3af; }
.text-gray-500 { color: #6b7280; }
.text-gray-600 { color: #4b5563; }
.text-gray-700 { color: #374151; }
.text-gray-800 { color: #1f2937; }
.text-gray-900 { color: #111827; }
.text-orange-main { color: #FF6B00; }
.bg-white { background-color: #ffffff; }
.bg-transparent { background-color: transparent; }
.bg-gray-50 { background-color: #f9fafb; }
.bg-gray-100 { background-color: #f3f4f6; }
.bg-gray-200 { background-color: #e5e7eb; }
.bg-primary { background-color: #FFD700; }
.bg-orange-main { background-color: #FF6B00; }
.bg-fff0e5 { background-color: #fff0e5; }

/* 定位 Positioning */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
.z-0 { z-index: 0; }
.z-10 { z-index: 10; }
.z-20 { z-index: 20; }
.z-40 { z-index: 40; }
.z-50 { z-index: 50; }

/* 边框圆角与特效 */
.rounded { border-radius: 8rpx; }
.rounded-sm { border-radius: 4rpx; }
.rounded-lg { border-radius: 16rpx; }
.rounded-xl { border-radius: 24rpx; }
.rounded-2xl { border-radius: 32rpx; }
.rounded-full { border-radius: 9999rpx; }
.shadow-sm { box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05); }
.shadow-md { box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); }
.shadow-lg { box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.15); }
.border { border-width: 2rpx; border-style: solid; border-color: transparent; box-sizing: border-box; }
.border-gray { border-color: #e5e7eb; }
.border-b { border-bottom: 2rpx solid #f3f4f6; }
.border-t { border-top: 2rpx solid #f3f4f6; }

/* 动画与交互 */
.animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
.animate-spin { animation: spin 1s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* 按钮重置 */
.btn-reset { margin: 0; width: 100% !important; padding: 0 !important; min-height: 0 !important; line-height: inherit; background-color: transparent; border-radius: 0; display: flex !important; flex-direction: column; align-items: center; justify-content: center; overflow: visible !important; }
button::after { border: none; }
