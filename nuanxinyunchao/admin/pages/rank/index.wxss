/* 模仿 active:scale-95 */
.active-scale:active {
  transform: scale(0.95);
}

.header-padding-rank {
  padding-top: calc(3rem + env(safe-area-inset-top));
}

.pt-safe {
  padding-top: 20px; /* Fallback */
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.pb-safe {
  padding-bottom: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
/* =========================================
   重构：顶部切换按钮专属样式 (完全脱离全局原子类)
   ========================================= */

/* 1. 按钮主容器：固定高度，抛弃 padding 撑高 */
.custom-tab-btn {
  position: relative;
  height: 56rpx;        /* 强制锁定高度 */
  padding: 0 32rpx;     /* 固定左右边距 */
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 2. 背景图片容器：绝对定位，不影响内容排版 */
.custom-tab-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  border-radius: 999rpx;
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.5);
  box-sizing: border-box;
}

.custom-tab-bg .bg-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 3. 内容容器：和主容器等高，使用 flex 居中 */
.custom-tab-content {
  position: relative;
  z-index: 10;
  height: 100%;         /* 填满父级高度，确保基准线一致 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 4. 图标样式 */
.custom-tab-content .tab-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;   /* 替代 gap-1 */
  flex-shrink: 0;
  display: block;
}

/* 5. 文字终极居中方案：收紧行高，转为 inline-flex */
.custom-tab-content .tab-text {
  font-size: 24rpx;
  font-weight: 700;
  line-height: normal; /* 核心：必须恢复正常行高，让外层的 flex 自动去平齐 */
}
