/* ================= Popup ================= */
.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
}

.popup-content {
  position: relative;
  width: 70%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-bg { width: 100%; }

.popup-list {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 68%;
  transform: translateY(-50%);
  z-index: 10;
}

.publish-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 16rpx;
}

.publish-btn {
  height: 64rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f37341;
  border-radius: 99rpx;
  background-color: white;
  font-size: 28rpx;
  color: black;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}

.publish-btn:active {
  background-color: #f37341;
  color: white;
}

.close-btn {
  margin-top: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid white;
  border-radius: 50%;
  background-color: transparent;
  backdrop-filter: blur(8rpx);
}

