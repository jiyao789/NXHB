.chart-bg-pattern {
  background-image: repeating-linear-gradient(to right, transparent, transparent 19%, #e5e7eb 19.5%, #e5e7eb 20%);
}

.w-1px { width: 1px; }
.w-2px { width: 2px; }
.gap-2px { gap: 2px; }

.tab-active {
  background: linear-gradient(to right, #8ec21f, #a8d702);
  border-color: transparent;
  color: white;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
}

.tab-inactive {
  background-color: white;
  border-color: #e5e7eb;
  color: #4b5563;
}

.pt-safe {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.pb-safe {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
