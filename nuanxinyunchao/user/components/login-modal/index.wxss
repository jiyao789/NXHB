@import "../../styles/utilities.wxss";

.bg-black-60 { background-color: rgba(0,0,0,0.6); }

.z-9999 { z-index: 9999; }
.-z-10 { z-index: -10; }

.w-600 { width: 600rpx; }
.w-85 { width: 85%; }

.min-h-443 { min-height: 443rpx; }
.h-20 { height: 80rpx; }

.pt-12 { padding-top: 48rpx; }
.pb-8 { padding-bottom: 32rpx; }
.mb-10 { margin-bottom: 40rpx; }
.mt-4 { margin-top: 16rpx; }

.text-brown-5a { color: #6b5b4f; }
.text-orange-main { color: #FF6B00; background-color: #f0642d; }
.border-orange-light { border-color: #FF9F43; }
.active-bg-gray-50:active { background-color: #f9fafb; margin: 0; }
.active-opacity-90:active { opacity: 0.9; margin: 0; }
.transition-colors { transition: background-color 0.2s, color 0.2s; }
.transition-opacity { transition: opacity 0.2s; }

@keyframes fadeInUp {
  from { opacity: 0; transform: scale(0.9) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.animate-fade-in-up {
  animation: fadeInUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
