/* 气泡样式 (WXMP does not support cover-view custom structures simply via data markers, 
   we construct the customCallout via TS marker array configuration. ) */
.custom-callout {
  position: relative;
  display: block;
  width: 140rpx;
  height: 158rpx;
}

.callout-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.callout-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 98%;
  height: 128rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 6rpx;
}

.bubble-icon {
  width: 45rpx;
  height: 49rpx;
  margin-bottom: 4rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

/** 点位详情大图：铺满方形容器并裁切溢出 */
.merchant-logo-box {
  position: relative;
}

.merchant-logo-img {
  display: block;
  width: 100%;
  height: 100%;
}

.bubble-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 90%;
}