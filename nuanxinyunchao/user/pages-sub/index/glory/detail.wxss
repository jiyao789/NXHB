@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

.article-title {
  font-size: 40rpx;
  color: #1a1a1a;
  font-weight: bold;
  line-height: 1.4;
  margin-bottom: 30rpx;
  display: block;
  text-align: justify;
}

.article-content {
  color: #333;
  font-size: 32rpx;
  line-height: 1.8;
  text-align: justify;
  width: 100%;
  overflow-x: hidden; /* 防止富文本异常导致的横向溢出 */
}

.article-content rich-text {
  display: block;
}

.article-content p {
  margin-bottom: 30rpx !important;
  display: block;
}

/* 微信小程序中 rich-text 内部样式的特殊处理 */
.article-content image {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  border-radius: 16rpx;
  margin: 40rpx 0;
}

.animate-fade-in {
  animation: fadeIn 0.4s ease-out;
}

.h-80 { height: 320rpx; }
.h-8 { height: 64rpx; }

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-spin {
  animation: spin 1s linear infinite;
}

.hexagon {
  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
}

.bg-f5f7fa {
  background-color: #F5F7FA;
}

.bg-white {
  background-color: #FFFFFF;
}

.bg-black-10 {
  background-color: rgba(0, 0, 0, 0.1);
}

.bg-FF6B00 {
  background-color: #FF6B00;
}

.bg-gradient-to-b {
  background: linear-gradient(to bottom, var(--tw-gradient-from), var(--tw-gradient-to));
}

.from-FFD54F {
  --tw-gradient-from: #FFD54F;
}

.to-FFB300 {
  --tw-gradient-to: #FFB300;
}

.text-8B4500 {
  color: #8B4500;
}

.top-30-px {
  top: 60rpx;
}

.top-5 {
  top: 10rpx;
}

/* 修复：图标显式宽高 */
.icon-32 {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.icon-24 {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

button::after {
  border: none;
}

.shadow-top-light {
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.active-scale {
  transition: transform 0.2s ease;
}

.active-scale:active {
  transform: scale(0.95);
}

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}

