<view class="page-container">
  <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/points/points_bg.png" class="page-bg" mode="aspectFill"></image>

  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="h-8 w-8 flex items-center justify-center rounded-full" hover-class="bg-black-10" bindtap="goBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900"></view>
      </view>
      <text class="nav-title">我们的荣耀时刻</text>
      <view class="nav-capsule-placeholder"></view> </view>
  </view>

  <view class="fixed-section">
    <view class="card-featured" wx:for="{{topList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="tag-pin">
        <text class="i-custom-pin"></text>
        <text class="tag-text">置顶推荐</text>
      </view>
      <view class="featured-image-wrapper">
        <image class="featured-image" src="{{item.image}}" mode="widthFix"></image>
        <view class="tag-star">本月之星</view>
      </view>
      <view class="featured-body">
        <view class="featured-title">{{item.title}}</view>
        <view class="featured-desc">{{item.desc}}</view>
        <view class="featured-footer">
          <text class="date-text">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view 
    scroll-y 
    class="scroll-section" 
    enhanced 
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onRefresherRefresh"
    bindscrolltolower="onReachBottom"
  >
    <view class="list-container">
      <!-- 常规列表 -->
      <view class="list-item" wx:for="{{normalList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <view class="item-text-group">
            <view class="item-title">{{item.title}}</view>
            <view class="item-desc">{{item.subtitle}}</view>
          </view>
          <view class="item-bottom">
            <text class="date-text">{{item.date}}</text>
          </view>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="loading-state" wx:if="{{isLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!isLoading && normalList.length === 0 && topList.length === 0}}">
        <view class="empty-icon i-carbon-ibm-cloud-box"></view>
        <text class="empty-text">暂无相关荣耀时刻</text>
      </view>

      <!-- 没有更多内容 -->
      <view class="no-more-state" wx:if="{{!hasMore && normalList.length > 0}}">
        <view class="no-more-line"></view>
        <text class="no-more-text">到底啦，没有更多内容了</text>
        <view class="no-more-line"></view>
      </view>

      <view class="safe-bottom"></view>
    </view>
  </scroll-view>
</view>