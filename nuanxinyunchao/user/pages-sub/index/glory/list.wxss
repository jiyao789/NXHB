@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* --- 页面基础布局 --- */
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden; /* 防止页面整体弹性滚动 */
}

/* 全屏背景图 */
.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}

/* --- 自定义导航栏 --- */
.custom-nav {
  width: 100%;
  flex-shrink: 0;
  z-index: 100;
  /* 导航栏也可以加一点极淡的渐变或毛玻璃，这里保持透明透出背景图 */
}

.nav-content {
  height: 44px; /* 微信标准标题栏高度 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.nav-capsule-placeholder {
  width: 64rpx; /* 与新的返回按钮 (h-8=64rpx) 等宽，保证标题居中 */
}

/* --- 固定置顶模块 --- */
.fixed-section {
  flex-shrink: 0;
  padding: 10rpx 32rpx 24rpx; /* 统一容器内边距 */
  z-index: 10;
}

/* 置顶卡片：毛玻璃效果 */
.card-featured {
  background: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.5); /* 增加边缘高光立体感 */
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.tag-pin {
  position: absolute;
  top: -12rpx;
  left: -8rpx;
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 10rpx 28rpx;
  border-radius: 16rpx 16rpx 16rpx 4rpx;
  z-index: 2;
  box-shadow: 4rpx 4rpx 15rpx rgba(255, 77, 79, 0.4);
  display: flex;
  align-items: center;
}

.tag-pin .i-custom-pin {
  font-size: 32rpx;
  margin-right: 6rpx;
}

.featured-image-wrapper {
  width: 100%;
  max-height: 480rpx; /* <<< 修改这里控制最大高度，超出部分裁剪，比例保持正常 */
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background: #f5f5f5;
}

.featured-image {
  width: 100%;
  height: auto;
  display: block;
}

.tag-star {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #FFD100;
  color: #1a1a1a;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 209, 0, 0.4);
}

.featured-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1a1a1a;
  margin: 24rpx 0 12rpx;
  line-height: 1.4;
}

.featured-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* --- 滚动列表模块 --- */
.scroll-section {
  flex: 1; /* 占据剩余全部高度 */
  overflow: hidden;
}

.list-container {
  padding: 0 32rpx; /* 统一左右内边距 */
}

/* 普通列表项：毛玻璃效果 */
.list-item {
  background: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.item-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.item-info {
  margin-left: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-bottom {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.date-text {
  font-size: 22rpx;
  color: #999;
}


/* --- 列表状态指示器 --- */

/* 加载中状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(13, 110, 253, 0.1);
  border-left-color: #0d6efd;
  border-radius: 50%;
  animation: spinner 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spinner {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: rgba(0, 0, 0, 0.05); /* 极淡的图标作为背景 */
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* 没有更多了 */
.no-more-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx 80rpx;
}

.no-more-line {
  flex: 1;
  height: 2rpx;
  background: rgba(0, 0, 0, 0.05);
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
  margin: 0 32rpx;
  white-space: nowrap;
}

/* 适配底部安全距离 */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}