@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* ================= 基础重置与工具 ================= */
.page-container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #f9fafb;
  position: relative;
}

.bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.truncate {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-active-scale:active {
  transform: scale(0.95);
}

.pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ================= 导航栏 ================= */
.custom-nav {
  position: relative;
  z-index: 50;
  flex-shrink: 0;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.btn-hover {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon-back {
  font-size: 48rpx;
  color: #1f2937;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.nav-capsule-placeholder {
  width: 64rpx; /* 与新的返回按钮等宽，保证标题居中 */
}

/* ================= Banner 区 ================= */
.banner-area {
  position: relative;
  z-index: 10;
  flex-shrink: 0;
  padding: 16rpx 24rpx 64rpx;
}

.banner-swiper {
  height: 440rpx;
  width: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  background-color: #e5e7eb;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  transform: translateY(0);
}

.banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
  pointer-events: none;
  z-index: 10;
}

.banner-indicators {
  position: absolute;
  bottom: 88rpx;
  right: 56rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.indicator-dot {
  height: 12rpx;
  border-radius: 999rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(4rpx);
  transition: all 0.3s;
  width: 12rpx;
  opacity: 0.6;
}

.indicator-dot.active {
  width: 32rpx;
  opacity: 1;
}

/* ================= 主体内容区 ================= */
.main-container {
  position: relative;
  z-index: 20;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 80rpx 80rpx 0 0;
  padding: 16rpx 32rpx 0;
  margin-top: -104rpx;
}

.main-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 筛选栏 */
.filter-bar {
  position: relative;
  z-index: 50;
  flex-shrink: 0;
}

.filter-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 128rpx;
  padding: 24rpx 48rpx;
  font-size: 36rpx;
  color: #000;
}

.filter-item {
  position: relative;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: color 0.3s;
}

.filter-btn.active {
  color: #FF8F44;
  font-weight: 500;
}

.filter-icon {
  font-size: 40rpx;
  color: #9ca3af;
  transition: transform 0.3s;
}

.filter-icon.rotate {
  transform: rotate(180deg);
}

/* 下拉菜单 */
.filter-dropdown {
  position: absolute;
  left: 50%;
  top: 100%;
  margin-top: 16rpx;
  min-width: 240rpx;
  border-radius: 24rpx;
  background-color: #fff;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.1);
  transform: translateX(-50%);
  overflow: hidden;
  z-index: 60;
}

.dropdown-list {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
}

.dropdown-option {
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4b5563;
}

.dropdown-option.active {
  background-color: rgba(255, 143, 68, 0.1);
  color: #FF8F44;
  font-weight: 500;
}

.bg-gray-50 {
  background-color: #f9fafb;
}

/* 遮罩层 */
.filter-mask {
  position: absolute;
  inset: 0;
  z-index: 40;
  background-color: rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(2px);
}

/* ================= 列表区域 ================= */
.list-scroll-view {
  position: relative;
  z-index: 10;
  flex: 1;
  height: 0;
  width: 100%;
}

.list-inner {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 16rpx 8rpx;
}

.card-item {
  border-radius: 24rpx;
  background-color: #fff;
  padding: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
  overflow: hidden;
}

.card-hover {
  transform: scale(0.98);
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.org-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.org-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #f3f4f6;
  flex-shrink: 0;
}

.org-text {
  display: flex;
  flex-direction: column;
}

.org-name {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: bold;
  line-height: 1;
}

.org-category {
  font-size: 20rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.status-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-waiting {
  background-color: #f3f4f6;
  color: #6b7280;
}

.status-done {
  background-color: rgba(130, 194, 66, 0.1);
  color: #82c242;
  border: 2rpx solid #82c242;
}

/* 分割线 */
.card-divider {
  height: 2rpx;
  width: 100%;
  background-color: #e5e7eb;
  margin: 24rpx 0;
}

/* 卡片主体 */
.card-body {
  display: flex;
  gap: 24rpx;
}

.card-img-box {
  position: relative;
  height: 160rpx;
  width: 224rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 32rpx;
  background-color: #f3f4f6;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-img-tag {
  position: absolute;
  left: 0;
  top: -4rpx;
  min-height: 60rpx;
  min-width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 0 0 16rpx 0;
}

.tag-bg {
  position: absolute;
  inset: 0;
  left: 0;
  z-index: 0;
  width: 100%;
}

.tag-text {
  position: relative;
  z-index: 10;
  padding: 0 12rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: 500;
  line-height: 1;
  margin-top: -8rpx;
}

/* 右侧文案 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
  min-width: 0;
}

.info-title {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: bold;
  line-height: 1.3;
}

.mini-tag-wrap {
  margin-top: 12rpx;
  display: flex;
}

.mini-tag {
  border-radius: 8rpx;
  background-color: #FFF0E5;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
  color: #FF8F44;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.info-bottom {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1f2937;
}

.meta-gray {
  color: #9ca3af;
}

.meta-icon {
  flex-shrink: 0;
  font-size: 20rpx;
}

.meta-text {
  font-size: 20rpx;
}

/* ================= 动画 ================= */
.animate-slide-down {
  animation: slideDown 0.2s ease-out forwards;
  transform-origin: top center;
}

@keyframes slideDown {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(-10rpx);
  }

  100% {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

/* ================= 任务悬浮按钮 (复刻自 Hot 页面) ================= */
.fixed-right-0-z-100 {
  position: fixed;
  right: 0;
  z-index: 1000;
}

.items-center { display: flex; align-items: center; }
.justify-center { display: flex; justify-content: center; }
.rounded-full { border-radius: 999rpx; }
.shadow-lg { box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1); }
.transition-all { transition: all 0.3s ease; }
.gap-2 { gap: 16rpx; }
.gap-1-5 { gap: 12rpx; }
.h-4 { height: 32rpx; }
.w-4 { width: 32rpx; }
.text-white { color: #ffffff; }
.text-xs { font-size: 24rpx; }
.text-lg { font-size: 32rpx; }
.font-bold { font-weight: bold; }
.whitespace-nowrap { white-space: nowrap; }
.bg-white-20 { background-color: rgba(255, 255, 255, 0.2); }

.task-floating-btn {
  top: 240rpx;
  background: linear-gradient(135deg, #ff7715, #ff9d42);
  color: #ffffff;
  padding: 18rpx 32rpx 18rpx 24rpx;
  border-top-left-radius: 100rpx;
  border-bottom-left-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 119, 21, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-right: none;
}

.task-floating-btn:active {
  transform: scale(0.95) translateX(10%);
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-10rpx); }
  60% { transform: translateY(-5rpx); }
}

.animate-bounce {
  animation: bounce 1s infinite;
}