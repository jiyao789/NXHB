<view class="min-h-screen bg-F5F7FA pb-28">
    <view class="relative w-full bg-white">
        <swiper wx:if="{{detailData.imagesList && detailData.imagesList.length > 0}}" class="w-full" style="height: 500rpx;" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FFD700">
            <swiper-item wx:for="{{detailData.imagesList}}" wx:key="*this">
                <image src="{{item}}" mode="aspectFill" class="h-full w-full" />
            </swiper-item>
        </swiper>
        <image wx:else src="{{ detailData.image }}" mode="widthFix" class="w-full block" />
        
        <!-- 返回按钮顶部占位和背景 -->
        <view class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-black-50 to-transparent pointer-events-none" />

        <view class="fixed left-0 top-0 z-50 flex items-center px-4"
            style="padding-top: {{safeAreaTop}}px; height: {{safeAreaTop + 44}}px;">
            <view class="flex h-8 w-8 items-center justify-center rounded-full bg-black-20 backdrop-blur-md"
                bindtap="handleBack">
                <view class="i-carbon-chevron-left text-2xl text-white" />
            </view>
        </view>
    </view>

    <!-- 任务悬浮按钮 (复刻 Hot 同款样式) -->
    <view wx:if="{{taskInfo.active}}" class="fixed-right-0-z-100 flex items-center shadow-lg transition-all task-floating-btn" bindtap="handleBackToTasks">
        <view class="flex items-center gap-2">
            <view class="h-4 w-4 flex items-center justify-center rounded-full bg-white-20">
                <view class="i-carbon-chevron-left text-white text-xs"></view>
            </view>
            <view class="flex items-center gap-1-5">
                <view wx:if="{{taskInfo.isCompleted}}" class="i-carbon-checkmark-filled text-white text-lg flex-shrink-0 animate-bounce"></view>
                <text class="text-white text-xs font-bold whitespace-nowrap">{{taskInfo.isCompleted ? '返回中心' : ('正在浏览中 ' + taskInfo.countdown + 's')}}</text>
            </view>
        </view>
    </view>

    <view class="relative z-10 mt-2 flex flex-col gap-3 px-3">

        <view class="rounded-xl flex-col gap-2 bg-white p-4 shadow-sm">
            <view class="block text-lg font-bold text-gray-900 leading-tight">
                <text class="mr-2">{{ detailData.title }}</text>
                <view class="inline-flex items-center justify-center rounded-2xl px-1-5 py-0-5 text-20rpx font-medium align-middle translate-y-minus-2rpx bg-feece5 text-ed792a">置顶推荐</view>
            </view>

            <view class="mt-3 text-sm text-gray-500 flex items-center justify-between">
                <text>发布于 {{ detailData.editTime }}</text>
                <text class="text-xs">{{ detailData.orgName }}</text>
            </view>
        </view>

        <view class="rounded-xl bg-white p-4 shadow-sm flex flex-col gap-4">
            <view class="text-base font-bold text-FF8F44 border-b border-gray-100 pb-2">活动信息</view>

            <view class="flex items-start gap-2 text-sm text-gray-600">
                <view class="i-carbon-location flex-shrink-0 w-5 h-5 text-gray-400" />
                <text class="leading-5">地址：{{ detailData.location }}</text>
            </view>

            <view class="flex items-start gap-2 text-sm text-gray-600">
                <view class="i-carbon-time flex-shrink-0 w-5 h-5 text-gray-400" />
                <text class="leading-5">时间：{{ detailData.timeRange }}</text>
            </view>

            <view class="flex items-start gap-2 text-sm text-gray-600">
                <view class="i-carbon-information flex-shrink-0 w-5 h-5 text-gray-400" />
                <text class="leading-5">备注：{{ detailData.remarks }}</text>
            </view>

            <view class="relative flex items-center gap-2 mt-2">
                <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/checkin/icon_star.png" class="h-6 w-6 flex-shrink-0" mode="aspectFit" />
                <view class="flex-1 text-sm font-medium p-2 rounded-lg bg-FFF5E5 text-FF8F44 leading-tight">奖励机制：{{ detailData.awardMechanism }}</view>
            </view>
        </view>

        <view class="rounded-xl bg-white p-4 shadow-sm flex flex-col gap-2">
            <view class="text-base font-bold text-FF8F44 border-b border-gray-100 pb-2 mb-2">活动详情</view>
            <text class="text-gray-600 text-sm leading-relaxed" space="nbsp">{{ detailData.fullText }}</text>
        </view>
    </view>

    <view class="fixed bottom-0 left-0 right-0 z-50 bg-white px-4 pb-safe pt-2 shadow-custom-bottom">
        <view class="flex h-14 items-center justify-center">
            <view wx:if="{{detailData.acceptStatus === '已接单'}}" class="flex h-10 flex-1 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-500 shadow-sm font-medium">
                已接单
            </view>
            <view wx:elif="{{detailData.acceptStatus === '待接单' && !detailData.inTimeRange}}" class="flex h-10 flex-1 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-500 shadow-sm font-medium">
                不在活动时间
            </view>
            <view wx:else class="flex h-10 flex-1 items-center justify-center rounded-full bg-FFD700 text-sm text-black shadow-sm transition-transform active-scale-95 font-medium" bindtap="handleJoin">
                立即加入
            </view>
        </view>
    </view>
</view>