<view class="min-h-screen bg-F5F7FA pb-28">
    <view class="relative w-full bg-white">
        <swiper wx:if="{{detailData.imagesList && detailData.imagesList.length > 0}}" class="w-full" style="height: 500rpx;" indicator-dots="{{true}}" autoplay="{{true}}" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FFD700">
            <swiper-item wx:for="{{detailData.imagesList}}" wx:key="*this">
                <image src="{{item}}" mode="aspectFill" class="h-full w-full" />
            </swiper-item>
        </swiper>
        <image wx:else src="{{ detailData.image }}" mode="aspectFill" class="w-full h-300px block" />
        <view class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-black-50 to-transparent pointer-events-none" />
        <view class="fixed left-0 top-0 z-50 flex items-center px-4" style="padding-top: {{safeAreaTop}}px; height: {{safeAreaTop + 44}}px;">
            <view class="flex h-8 w-8 items-center justify-center rounded-full bg-black-20 backdrop-blur-md" bindtap="handleBack">
                <view class="i-carbon-chevron-left text-2xl text-white" />
            </view>
        </view>
    </view>
    <!-- 任务悬浮按钮 (复刻 Hot 同款样式) -->
    <view wx:if="{{taskInfo.active}}" class="fixed-right-0-z-100 flex items-center shadow-lg transition-all task-floating-btn" bindtap="handleBackToTasks">
        <view class="flex items-center gap-2">
            <view class="h-4 w-4 flex items-center justify-center rounded-full bg-white-20">
                <view class="i-carbon-chevron-left text-white text-xs"></view>
            </view>
            <view class="flex items-center gap-1-5">
                <view wx:if="{{taskInfo.isCompleted}}" class="i-carbon-checkmark-filled text-white text-lg flex-shrink-0 animate-bounce"></view>
                <text class="text-white text-xs font-bold whitespace-nowrap">
                    {{taskInfo.isCompleted ? '返回中心' : ('正在浏览中 ' + taskInfo.countdown + 's')}}
                </text>
            </view>
        </view>
    </view>
    <view class="relative z-10 mt-2 flex flex-col gap-3 px-3">
        <view class="rounded-xl flex-col gap-2 bg-white p-4 shadow-sm">
            <view class="block text-lg font-bold text-gray-900 leading-tight">
                <text class="mr-2">{{ detailData.title }}</text>
            </view>
            <view class="mt-3 text-sm text-gray-500 flex items-center justify-between">
                <text>活动时间：{{ detailData.timeRange }}</text>
            </view>
        </view>
        <view class="rounded-xl bg-white p-4 shadow-sm">
            <view class="mb-4 text-base font-bold text-FF8F44 border-b border-gray-100 pb-2">
                活动信息
            </view>
            <view class="flex flex-col gap-4 mb-4">
                <view class="flex items-start gap-2 text-sm text-gray-600">
                    <view class="i-carbon-location flex-shrink-0 w-5 h-5 text-gray-400" />
                    <text class="leading-5">地址：{{ detailData.location }}</text>
                </view>
                <view class="flex items-start gap-2 text-sm text-gray-600">
                    <view class="i-carbon-time flex-shrink-0 w-5 h-5 text-gray-400" />
                    <text class="leading-5">时间：{{ detailData.timeRange }}</text>
                </view>
                <view class="flex items-start gap-2 text-sm text-gray-600">
                    <view class="i-carbon-help flex-shrink-0 w-5 h-5 text-gray-400" />
                    <view class="leading-5">
                        <text>如有疑问请联系：</text>
                        <text class="text-blue-500" bindtap="handleCall">
                            {{ detailData.contactPhone }}
                        </text>
                        <text>({{ detailData.orgName }})</text>
                    </view>
                </view>
                <view class="relative flex items-center gap-2">
                    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/checkin/icon_star.png" class="h-6 w-6 flex-shrink-0" mode="aspectFit" />
                    <view class="flex-1 text-sm font-medium p-2 rounded-lg bg-FFF5E5 text-FF8F44 leading-tight">
                        奖励机制：{{ detailData.awardMechanism }}
                    </view>
                </view>
            </view>
        </view>
        <view class="rounded-xl bg-white p-4 shadow-sm flex flex-col gap-2">
            <view class="text-base font-bold text-FF8F44 border-b border-gray-100 pb-2 mb-2">
                活动详情
            </view>
            <view class="flex flex-col gap-3">
                <view class="flex items-start gap-2 text-sm">
                    <text class="text-gray-500 flex-shrink-0 font-medium">招募对象：</text>
                    <text class="text-gray-800">{{ detailData.recruitTarget }}</text>
                </view>
                <view class="flex flex-col gap-1 text-sm mt-1">
                    <text class="text-gray-500 font-medium">能力要求与说明：</text>
                    <text class="text-gray-600 leading-relaxed" space="nbsp">
                        {{ detailData.fullText }}
                    </text>
                </view>
            </view>
        </view>
        <view class="rounded-xl bg-white p-4 shadow-sm">
            <view class="mb-4 text-base font-bold text-FF8F44 border-b border-gray-100 pb-2">
                报名成员
            </view>
            <view class="grid grid-cols-5 gap-y-4">
                <view wx:for="{{memberList}}" wx:for-item="member" wx:key="index" class="flex flex-col items-center gap-1">
                    <image src="{{member.avatar}}" class="h-10 w-10 rounded-full bg-gray-100" />
                    <text class="text-xs text-gray-500">{{ member.name }}</text>
                </view>
            </view>
            <view wx:if="{{memberList.length === 0}}" class="py-4 text-center text-sm text-gray-400">
                暂无人员报名，快来做第一个吧~
            </view>
        </view>
    </view>
    <view class="fixed bottom-0 left-0 right-0 z-50 bg-white px-4 pb-safe pt-2 shadow-custom-bottom">
        <view class="flex h-14 items-center justify-center">
            <view wx:if="{{detailData.acceptStatus === '待接单' && detailData.inTimeRange}}" class="flex h-10 flex-1 items-center justify-center rounded-full bg-FFD700 text-sm text-black shadow-sm transition-transform active-scale-95 font-medium" bindtap="handleAccept">
                我要接单
            </view>
            <view wx:elif="{{detailData.acceptStatus === '待接单' && !detailData.inTimeRange}}" class="flex h-10 flex-1 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-500 shadow-sm font-medium">
                不在活动时间
            </view>
            <view wx:elif="{{detailData.acceptStatus === '已满员'}}" class="flex h-10 flex-1 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-500 shadow-sm font-medium">
                已满员
            </view>
            <view wx:else class="flex h-10 flex-1 items-center justify-center rounded-full bg-gray-200 text-sm text-gray-500 shadow-sm font-medium">
                已接单
            </view>
        </view>
    </view>
</view>