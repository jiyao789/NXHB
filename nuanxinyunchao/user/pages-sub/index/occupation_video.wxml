<view class="page-container">
  
  <view class="nav-fixed" style="padding-top: {{safeAreaTop}}px;">
    <view class="nav-content">
      <view class="back-btn" hover-class="bg-active" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      
      <view wx:if="{{pageData.author}}" class="author-info">
        <image src="{{pageData.avatar}}" class="author-avatar" mode="aspectFill" />
        <text class="author-name">{{pageData.author}}</text>
      </view>
    </view>
  </view>

  <view class="nav-placeholder" style="height: {{safeAreaTop + 44}}px;"></view>

  <view class="cover-wrapper">
    <image src="{{pageData.imgUrl}}" class="cover-img" mode="aspectFill" />
  </view>

  <view class="info-section">
    <view class="page-title">{{pageData.title}}</view>
    
    <view class="page-content">
      <text wx:for="{{contentLines}}" wx:key="*this" class="content-line">{{item}}</text>
    </view>

    <view class="page-date">{{pageData.date}}</view>

    <view class="divider"></view>

    <view class="action-row">
      
      <view class="action-btn" hover-class="btn-hover" bindtap="handleLike">
        <view class="icon-like {{isLiked ? 'liked' : 'unliked'}}"></view>
        <text class="action-text {{isLiked ? 'text-orange' : 'text-gray'}}">{{isLiked ? '已点赞' : '点赞'}}</text>
      </view>

      <view class="action-btn" hover-class="btn-hover" bindtap="handleFavorite">
        <view class="icon-star {{isFavorited ? 'favorited' : 'unfavorited'}}"></view>
        <text class="action-text {{isFavorited ? 'text-yellow' : 'text-gray'}}">{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>

    </view>
  </view>

</view>