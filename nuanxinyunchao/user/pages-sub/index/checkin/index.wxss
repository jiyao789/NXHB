@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* ================== 重置原生 Button 默认破坏性样式 ================== */
button {
  margin: 0;
  padding: 0;
  width: auto !important;
  min-width: 0 !important;
  background-color: transparent;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.btn-active {
  opacity: 0.9;
  transform: scale(0.95);
}

/* ================== 布局核心 (脱离原子类) ================== */
.page-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.bg-img {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  transition: background-color 0.3s;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  background-color: rgba(0, 0, 0, 0.1);
}

.icon-back {
  font-size: 48rpx;
  color: #111827;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 40rpx;
  color: #715b40;
  font-weight: 600;
}

.main-content {
  padding: 32rpx 32rpx 0;
  position: relative;
  z-index: 10;
}

/* 头部大徽章与签到状态 */
.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
  position: relative;
  z-index: 20;
}

.badge-container {
  position: relative;
  width: 256rpx;
  height: 288rpx;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.badge-shadow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  height: 80rpx;
  opacity: 0.8;
}

.badge-img {
  position: absolute;
  top: -16rpx;
  left: 0;
  width: 100%;
  height: 90%;
  z-index: 10;
}

.header-info {
  flex: 1;
}

.header-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B5E3C;
  margin-right: 8rpx;
}

.help-icon-wrapper {
  padding: 8rpx;
  margin: -8rpx;
}

.help-icon {
  font-size: 28rpx;
  color: #8B5E3C;
}

.streak-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 24rpx;
  position: relative;
  top: -24rpx;
}

.streak-text {
  font-size: 36rpx;
  color: #8B5E3C;
}

.streak-days {
  font-size: 72rpx;
  font-weight: bold;
  color: #8B5E3C;
  margin: 0 8rpx;
}

.sign-btn {
  width: 256rpx !important;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(to right, #fb923c, #f97316);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.sign-btn.is-signed {
  background: linear-gradient(to right, #e87a16, #d9620b) !important;
  /* 背景渐变色整体加深 */
  color: rgba(161, 75, 24, 0.89) !important;
  /* 文字稍微变暗一点点，与未签到形成对比 */
  box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.1) !important;
  /* 改为内阴影，增加被按下的凹陷感 */
  opacity: 1 !important;
  /* 清除之前的透明度限制 */
  filter: none !important;
  /* 彻底移除变灰滤镜 */
}

/* 弯钩进度条 */
.curve-container {
  position: relative;
  width: 100%;
  height: 112rpx;
  margin-top: -48rpx;
  margin-bottom: 8rpx;
  z-index: 10;
  pointer-events: none;
}

.curve-img {
  width: 100%;
  height: 100%;
}

.curve-rank {
  position: absolute;
  right: 12%;
  top: 65%;
  font-size: 24rpx;
  color: rgba(139, 94, 60, 0.6);
}

.distance-text {
  font-size: 24rpx;
  color: rgba(139, 94, 60, 0.8);
  padding: 0 16rpx;
  font-weight: 500;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 20;
}

/* 7天签到列表 */
.days-section {
  position: relative;
  margin-bottom: 64rpx;
}

.days-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 8rpx;
  position: relative;
  z-index: 10;
  height: 100%;
}

.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.day-box {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.day-box.is-signed {
  width: 88rpx;
  height: 116rpx;
  background-color: #ffbe5f;
  border: 2rpx solid #ea8e48;
  border-radius: 32rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(234, 142, 72, 0.3);
  transform: scale(1.05);
}

.day-box:not(.is-signed) {
  width: 88rpx;
  height: 120rpx;
  background-color: #f2f1dd;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 12rpx rgba(237, 145, 83, 0.1);
  box-sizing: border-box;
}

.check-icon {
  font-size: 40rpx;
  font-weight: bold;
}

.hex-inner {
  position: relative;
  width: 56rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hex-bg {
  position: absolute;
  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
}

.hex-bg.dark {
  inset: 0;
  background-color: #ffbf61;
}

.hex-bg.light {
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  background-color: #fcdbb4;
}

.hex-score {
  position: relative;
  z-index: 10;
  font-size: 20rpx;
  font-weight: bold;
  color: #ea8e48;
}

.day-label {
  font-size: 20rpx;
  color: rgba(139, 94, 60, 0.7);
  font-weight: 500;
  margin-top: 8rpx;
}

/* 任务列表 */
.task-card {
  background-color: #fff;
  border-radius: 48rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  margin-top: 16rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #1f2937;
}

.mb-16rpx {
  margin-bottom: 32rpx;
}

.refresh-icon {
  font-size: 36rpx;
  color: #9ca3af;
  transition: transform 0.5s;
}

.rotate-180 {
  transform: rotate(180deg);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.task-info {
  flex: 1;
  margin-right: 16rpx;
}

.task-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.task-points-wrap {
  position: relative;
  margin-left: 20rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
}

.task-points-pill {
  background-color: #ffecc5;
  border-radius: 999rpx;
  padding: 4rpx 16rpx 4rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.points-text {
  font-size: 24rpx;
  color: #ff7f04;
  font-weight: 500;
  line-height: 1;
}

.star-icon {
  position: absolute;
  left: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
}

.task-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 40rpx;
  border-radius: 28rpx;
  background-color: #ED9153;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.task-btn.is-completed {
  background-color: #e5e7eb;
  color: #9ca3af;
  box-shadow: none;
}

.special-task-line {
  padding-top: 2rpx;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 0 64rpx;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  width: 100%;
  background-color: #fff;
  border-radius: 48rpx;
  padding: 48rpx;
  position: relative;
  animation: zoomIn 0.2s ease-out;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  display: block;
  color: #1f2937;
  margin-bottom: 48rpx;
}

.modal-scroll {
  max-height: 512rpx;
  margin-bottom: 48rpx;
}

.rule-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
}

.rule-num {
  font-weight: bold;
  color: #f97316;
}

.rule-text {
  flex: 1;
}

.modal-close-btn {
  width: 100%;
  border-radius: 999rpx;
  background-color: #ED9153;
  color: #fff;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes zoomIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}