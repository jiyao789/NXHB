@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* ================= 重置与基础 ================= */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  border-radius: 0;
}

button::after {
  border: none !important;
  display: none !important;
}

.btn-active {
  opacity: 0.8;
  transform: scale(0.96);
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.truncate {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 页面整体框架 */
.page-container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 导航栏 */
.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 50;
  transition: all 0.3s;
}

.nav-content {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}

.nav-back-btn {
  position: absolute;
  left: 16rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.btn-hover {
  background-color: rgba(230, 230, 230, 0.5);
}

.icon-back {
  font-size: 48rpx;
  color: #111827;
}

.nav-title {
  font-size: 40rpx;
  color: #715b40;
  font-weight: 600;
}

/* 顶部固定区 */
.top-fixed-area {
  position: relative;
  z-index: 10;
  width: 100%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

/* 积分卡片 */
.points-card-wrapper {
  margin-top: 32rpx;
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.points-card {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.card-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 48rpx;
  color: #fff;
}

.card-label {
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.card-score {
  font-size: 88rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  line-height: 1;
  font-family: sans-serif;
}

.card-date {
  font-size: 24rpx;
}

/* Tabs 切换 */
.tabs-container {
  margin: 32rpx 0 16rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 128rpx;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s;
}

.tab-text {
  font-size: 36rpx;
  color: #4b5563;
  transition: all 0.3s;
}

.tab-text.active {
  color: #F48C44;
  font-weight: bold;
  transform: scale(1.05);
}

.tab-line {
  height: 4rpx;
  width: 80rpx;
  border-radius: 999rpx;
  background-color: #F48C44;
  opacity: 0;
  transition: opacity 0.3s;
}

.tab-line.active {
  opacity: 1;
}

/* 滚动区域核心 (极其重要) */
.scroll-area {
  flex: 1;
  height: 0;
  position: relative;
  z-index: 10;
  width: 100%;
}

.scroll-inner {
  padding-bottom: 80rpx;
  min-height: 100%;
}

/* ================== 瀑布流 (赚积分) ================== */
.waterfall-container {
  width: 100%;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.waterfall-col {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed-card {
  width: 100%;
  border-radius: 24rpx;
  background-color: #fff;
  padding-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.feed-cover-box {
  position: relative;
  width: 100%;
}

.feed-cover {
  width: 100%;
  display: block;
}

.play-icon-box {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.3);
  padding: 16rpx;
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 48rpx;
  color: #fff;
}

.feed-title-box {
  margin-top: 16rpx;
  padding: 0 16rpx;
}

.feed-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: bold;
  line-height: 1.3;
}

.feed-footer {
  margin-top: 24rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
}

.feed-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.feed-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  margin-right: 8rpx;
}

.feed-author-row {
  display: flex;
  align-items: center;
}

.feed-author {
  max-width: 140rpx;
  font-size: 20rpx;
  color: #374151;
  font-weight: 500;
}

.feed-tag {
  margin-left: 8rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background-color: rgba(249, 249, 249, 0.5);
}

.tag-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.tag-text {
  font-size: 16rpx;
  color: #a99e97;
  white-space: nowrap;
  line-height: 1;
  padding-top: 2rpx;
}

.feed-date {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.feed-likes {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  gap: 4rpx;
}

.like-icon {
  font-size: 24rpx;
}

.like-count {
  font-size: 16rpx;
  line-height: 1;
}


/* ================== 网格流 (用积分) ================== */
.use-points-container {
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx;
}

/* 对应 px-3 */
.filter-section {
  margin-bottom: 32rpx;
  width: 100%;
}

/* 对应 mb-4 */
.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 32rpx;
}

/* 对应 gap-2 pr-4 */
.filter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 对应 flex flex-col items-center */

/* 筛选标签精确还原 (小圆角矩形，靠 padding 撑开) */
.filter-text {
  font-size: 24rpx;
  /* 对应 text-xs */
  padding: 8rpx 16rpx;
  /* 对应 py-1 px-2 (上下8rpx，左右16rpx) */
  border-radius: 12rpx;
  /* 对应 rounded-[6px] (6px=12rpx) */
  border: 2rpx solid transparent;
  /* 对应 border border-transparent */
  color: #111827;
  /* 对应未选中 text-gray-900 */
  background-color: #ffffff;
  /* 对应未选中 bg-white */
  display: inline-block;
  /* 回归内联块级，自然排版 */
  line-height: normal;
  /* 恢复原生行高，完美解决文字置底 */
  transition: all 0.3s;
  box-sizing: border-box;
}

/* 选中状态 */
.filter-text.active {
  color: #ffffff;
  /* 对应 text-white */
  background-color: #f7651a;
  /* 对应 bg-[#f7651a] */
}

.coupon-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  width: 100%;
}

.coupon-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 16rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border: 2rpx solid #f3f4f6;
}

.coupon-img-box {
  height: 224rpx;
  width: 100%;
  /* 上层：券包图完整居中显示；底层：保留 peach 渐变（透明区域透出） */
  background-color: #fff6f0;
  background-image: url('https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/points/bg1.png'), linear-gradient(to bottom, #ffe9c4, #fff6f0);
  background-repeat: no-repeat, no-repeat;
  background-position: center center, center center;
  /* 券包图高度略小于容器，上下留出渐变区域；第二层渐变仍铺满 */
  background-size: auto 84%, 100% 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0;
  box-sizing: border-box;
}

/* 券包中部：面值 / 折扣（整体上移，对齐示意图白条区域） */
.coupon-face-inner {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 20rpx;
  transform: translateY(-36rpx);
}

.coupon-face-main {
  font-size: 44rpx;
  font-weight: 700;
  color: #f7651a;
  line-height: 1.2;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-face-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.3;
  text-align: center;
  max-width: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.coupon-img-box.coupon-face-discount .coupon-face-main {
  color: #dc2626;
}

.coupon-info {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}

.coupon-title {
  display: block;
  font-size: 24rpx;
  color: #1f2937;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.coupon-subtitle {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
}

/* 底部价格与按钮区域 */
.coupon-bottom {
  width: 100%;
  /* 确保父容器撑满 100% */
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  /* 如果上方有空隙，自动推到底部 */
  padding-top: 16rpx;
}

.coupon-price {
  font-size: 40rpx;
  color: #ff3500;
  font-weight: bold;
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.price-unit {
  font-size: 24rpx;
  font-weight: normal;
  margin-left: 4rpx;
}

/* 兑换按钮 */
.exchange-btn {
  margin: 0 0 0 auto !important;
  /* 利用 auto margin 强制推到最右侧 */
  width: auto !important;
  border-radius: 999rpx;
  background: linear-gradient(to right, #fd603c, #ff4486);
  padding: 10rpx 28rpx !important;
  font-size: 24rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.5;
  flex-shrink: 0;
}

/* ================== 规则弹窗 ================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.6);
}

.modal-box {
  position: relative;
  width: 600rpx;
  min-height: 443rpx;
  overflow: hidden;
  border-radius: 48rpx;
}

.modal-bg {
  position: absolute;
  inset: 0;
  height: 100%;
  width: 100%;
  z-index: -10;
}

.modal-content {
  position: relative;
  z-index: 10;
  display: flex;
  height: 100%;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: 80rpx 64rpx 48rpx;
  text-align: center;
}

.modal-title {
  margin-bottom: 32rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #111827;
}

.modal-rules-scroll {
  max-height: 380rpx;
  margin-bottom: 48rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}

.modal-rule-line {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.55;
  color: #6b5b4f;
}

.modal-rule-line:last-child {
  margin-bottom: 0;
}

.modal-desc {
  margin-bottom: 64rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.6;
  color: #6b5b4f;
}

.modal-btn {
  width: 80% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 999rpx;
  background-color: #f0642d;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(253, 191, 159, 0.8);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

.animate-scale-in {
  animation: scaleIn 0.2s ease-out forwards;
}