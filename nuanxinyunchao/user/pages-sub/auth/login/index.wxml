<view class="min-h-screen flex flex-col bg-efecec px-6">
  <!-- 自定义导航栏 -->
  <view class="fixed left-0 right-0 top-0 z-50 bg-efecec px-4" style="padding-top: {{safeAreaTop}}px;">
    <view class="h-11 flex items-center">
      <view class="h-8 w-8 flex items-center justify-center rounded-full" hover-class="bg-black-5" bindtap="handleBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900"></view>
      </view>
    </view>
  </view>
  <view style="height: {{safeAreaTop + 44}}px;"></view>
  <!-- Logo 与 标题区域 -->
  <view class="mt-8 flex flex-col items-center">
    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/mine/about_logo.png" class="h-30 w-30 rounded-2xl mb-4" mode="aspectFit"></image>
  </view>
  <!-- 表单区域 -->
  <view class="flex flex-col gap-5">
    <!-- 手机号输入框 -->
    <view class="flex items-center rounded-full bg-white px-5 py-3-5 shadow-sm transition-all {{mobileFocused ? 'focus-ring' : ''}}">
      <view class="i-carbon-phone text-gray-400 text-xl mr-3"></view>
      <input value="{{formData.mobile}}" type="number" maxlength="11" placeholder="请输入手机号" class="flex-1 text-base text-gray-900 h-full" placeholder-class="text-gray-300" bindinput="onMobileInput" bindfocus="onMobileFocus" bindblur="onMobileBlur" />
      <view wx:if="{{formData.mobile}}" class="i-carbon-close-filled text-gray-300 text-lg" hover-class="text-gray-500" bindtap="clearMobile"></view>
    </view>
    <!-- 验证码输入框 + 发送按钮 -->
    <view class="flex gap-3">
      <view class="flex-3 h-11 flex items-center rounded-full bg-white px-5 shadow-sm transition-all {{codeFocused ? 'focus-ring' : ''}}">
        <view class="i-carbon-security text-gray-400 text-xl mr-3"></view>
        <input value="{{formData.code}}" type="number" maxlength="6" placeholder="请输入验证码" class="flex-1 text-base text-gray-900 h-full" placeholder-class="text-gray-300" bindinput="onCodeInput" bindfocus="onCodeFocus" bindblur="onCodeBlur" />
      </view>
      <!-- 发送验证码按钮 -->
      <button class="m-0 flex-2 h-11 flex items-center justify-center rounded-full border-none px-0 text-sm font-bold transition-all shadow-sm {{countdown > 0 ? 'bg-gray-100 text-gray-400' : 'bg-fff0e5 text-orange-main disabled-hover'}}" hover-class="{{countdown > 0 ? '' : 'scale-95'}}" disabled="{{countdown > 0}}" bindtap="handleSendCode">
        {{ countdown > 0 ? countdown + 's' : '获取验证码' }}
      </button>
    </view>
  </view>
  <!-- 操作按钮 -->
  <view class="mt-12 flex flex-col gap-4">
    <!-- 登录按钮 -->
    <button class="w-full h-12 flex items-center justify-center rounded-full bg-orange-main text-white font-bold text-lg shadow-lg shadow-orange-main-30 transition-all border-none" hover-class="scale-98" disabled="{{isLoading}}" bindtap="handleLogin">
      <view wx:if="{{isLoading}}" class="i-carbon-circle-dash animate-spin mr-2 text-xl"></view>
      {{ isLoading ? '登录中...' : '立即登录' }}
    </button>
    <!-- 注册引导 -->
    <view class="flex items-center justify-center gap-1 mt-4 py-2">
      <text class="text-sm text-gray-500">还没有账号？</text>
      <view class="text-sm text-orange-main font-bold px-2 py-1" bindtap="goToRegister">立即注册</view>
    </view>
  </view>
  <!-- 底部协议 -->
  <view class="mt-auto mb-8 flex flex-col items-center gap-1 text-xs text-gray-400">
    <view class="flex items-center gap-1">
      <view class="w-3-5 h-3-5 rounded-full border border-gray-300 flex items-center justify-center transition-colors {{isAgreed ? 'bg-orange-main border-orange-main' : 'bg-white'}}" bindtap="toggleAgree">
        <view wx:if="{{isAgreed}}" class="i-carbon-checkmark text-white text-10"></view>
      </view>
      <text bindtap="toggleAgree">同意</text>
      <text class="text-orange-main" bindtap="goToProtocol" data-type="service">《用户协议》</text>
      <text>和</text>
      <text class="text-orange-main" bindtap="goToProtocol" data-type="privacy">《隐私政策》</text>
    </view>
  </view>
</view>

<!-- 动态注入返回智慧党建飘窗 -->
<global-home-btn />
