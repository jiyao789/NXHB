/* 文本辅助 */
.text-6xl {
  font-size: 120rpx;
}
.font-bold {
  font-weight: 700;
}
.leading-5 {
  line-height: 40rpx;
}
.leading-tight {
  line-height: 1.25;
}
.leading-none {
  line-height: 1;
}
.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 交互与杂项 */
.transition-all {
  transition-property: all;
  transition-duration: 150ms;
}
.active-bg-gray-200:active {
  background-color: #e5e7eb;
}
.active-bg-gray-50:active {
  background-color: #f9fafb;
}
.active-opacity-80:active {
  opacity: 0.8;
}
.border-none {
  border: none;
}
/* 瀑布流布局样式 */
.waterfall-container {
  display: flex;
  gap: 16rpx;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feed-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.feed-cover-box {
  position: relative;
  width: 100%;
}

.feed-cover {
  width: 100%;
  display: block;
}

.feed-title-box {
  padding: 16rpx;
}

.feed-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
}

.feed-footer {
  display: flex;
  align-items: center;
  padding: 0 16rpx 16rpx;
  gap: 12rpx;
}

.feed-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.feed-info {
  flex: 1;
  min-width: 0;
}

.feed-author-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.feed-author {
  font-size: 22rpx;
  color: #999;
}

.feed-date {
  font-size: 20rpx;
  color: #ccc;
}

.feed-likes {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  gap: 4rpx;
}

.like-icon {
  font-size: 24rpx;
}

.like-count {
  font-size: 22rpx;
  color: #999;
}

