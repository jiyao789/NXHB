@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

.bg-f5f5f5 { background-color: #f5f5f5; }
.bg-orange-main { background-color: #FF6B00; }

.rating-tag {
    padding: 12rpx 32rpx;
    border-radius: 12rpx;
    font-size: 28rpx;
    transition: all 0.2s;
    border: 2rpx solid transparent;
}

.rating-tag.unselected {
    background-color: #F5F5F5;
    color: #666666;
}

.rating-tag.active {
    background-color: #FFF0E5;
    color: #FF6B00;
    border-color: #FF6B00;
    font-weight: bold;
}
