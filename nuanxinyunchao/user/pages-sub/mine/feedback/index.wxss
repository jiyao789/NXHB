@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

view, text, image, scroll-view, input, button { box-sizing: border-box !important; }
button { padding: 0; margin: 0; line-height: inherit; }
button::after { border: none; }

.min-h-screen { min-height: 100vh; }
.bg-F5F5F5 { background-color: #F5F5F5; }
.bg-white { background-color: #ffffff; }
.bg-FFF0E5 { background-color: #FFF0E5; }
.bg-gray-200 { background-color: #e5e7eb; }

.text-333 { color: #333333; }
.text-555 { color: #555555; }
.text-999 { color: #999999; }
.text-FF8F44 { color: #FF8F44; }
.text-7AC786 { color: #7AC786; }
.text-FF6B6B { color: #FF6B6B; }
.border-7AC786 { border-color: #7AC786; }
.border-FF6B6B { border-color: #FF6B6B; }

.text-17px { font-size: 34rpx; }
