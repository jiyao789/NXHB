.p-4 { padding: 32rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-1 { margin-bottom: 8rpx; }
.mx-2 { margin-left: 16rpx; margin-right: 16rpx; }
.mx-0-5 { margin-left: 4rpx; margin-right: 4rpx; }
.gap-3 { gap: 24rpx; }
.gap-1 { gap: 8rpx; }

.shadow-custom { box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.02); }
.active-bg-black-5:active { background-color: rgba(0, 0, 0, 0.05); }
.active-opacity-80:active { opacity: 0.8; }
.border-none { border: none; }
.border { border-width: 2rpx; border-style: solid; }

