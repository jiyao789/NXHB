<view class="min-h-screen flex flex-col bg-F5F5F5 pb-safe">
    <view class="bg-F5F5F5 sticky top-0 z-10">
      <view style="padding-top: {{safeAreaInsetsTop}}px;">
        <view class="relative h-11 flex items-center justify-center px-4">
          <view 
            class="absolute left-2 h-8 w-8 flex items-center justify-center rounded-full active-bg-black-5" 
            bindtap="handleBack"
          >
            <view class="i-carbon-chevron-left text-2xl text-333" />
          </view>
          <text class="text-17px text-333 font-medium">我的需求反馈</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="flex flex-1 items-center justify-center pt-20">
      <view class="animate-spin i-carbon-circle-dash text-3xl text-gray-400" />
    </view>
    
    <view wx:else class="flex flex-col gap-3 px-4 pt-2">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="bg-white rounded-xl p-4 shadow-custom"
        bindtap="handleDetail"
        data-item="{{item}}"
      >
        <view class="flex justify-between items-center mb-3">
          <text class="text-16px text-333 font-bold">我的需求</text>
          
          <view 
            class="px-3 py-2px rounded-full border text-xs {{item.statusClass}}"
          >
            {{ item.statusText }}
          </view>
        </view>
    
        <view class="h-1px bg-gray-200 mx-2 mb-1" />
        
        <view class="mb-4">
          <text class="text-sm text-555 leading-relaxed text-justify block">
            {{ item.content }}
          </text>
        </view>

        <view class="flex justify-between items-center">
          <view class="flex items-center gap-1 text-xs text-999">
            <view class="i-carbon-time text-sm" />
            <text>反馈时间</text>
            <text class="mx-0-5">|</text>
            <text>{{ item.time }}</text>
          </view>

          <view
            class="m-0 rounded border-none bg-FFF0E5 px-4 py-1-5 text-xs text-FF8F44 font-medium leading-normal active-opacity-80"
            catchtap="handleDetail"
            data-item="{{item}}"
          >
            点击查看
          </view>
        </view>
      </view>
    </view>
</view>