<view class="min-h-screen flex flex-col bg-efecec">
  <!-- 自定义导航栏 -->
  <view class="fixed left-0 right-0 top-0 z-50 bg-efecec" style="padding-top: {{safeAreaTop}}px;">
    <view class="relative h-11 flex items-center justify-center px-4">
      <view class="absolute left-2 h-8 w-8 flex items-center justify-center rounded-full" hover-class="bg-black-5" bindtap="handleBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900"></view>
      </view>
      <text class="text-lg text-gray-900 font-bold">修改密码</text>
    </view>
  </view>
  
  <view style="height: {{safeAreaTop + 44}}px;"></view>

  <view class="p-4">
    <view class="rounded-xl bg-white p-4">
      
      <!-- 旧密码 -->
      <view class="mb-4">
        <view class="text-gray-700 text-sm mb-2">旧密码</view>
        <view class="bg-gray-50 rounded-lg flex items-center px-3 py-2">
          <input class="flex-1 h-8 text-base text-gray-900" password="{{!showOldPassword}}" placeholder="请输入原密码" placeholder-class="text-gray-400" value="{{formData.password}}" bindinput="onInput" data-field="password" />
        </view>
      </view>

      <!-- 新密码 -->
      <view class="mb-4">
        <view class="text-gray-700 text-sm mb-2">新密码</view>
        <view class="bg-gray-50 rounded-lg flex items-center px-3 py-2">
          <input class="flex-1 h-8 text-base text-gray-900" password="{{!showNewPassword}}" placeholder="6-9位，须包含字母和数字" placeholder-class="text-gray-400" value="{{formData.newPassword}}" bindinput="onInput" data-field="newPassword" />
        </view>
      </view>

      <!-- 确认新密码 -->
      <view class="mb-6">
        <view class="text-gray-700 text-sm mb-2">确认新密码</view>
        <view class="bg-gray-50 rounded-lg flex items-center px-3 py-2">
          <input class="flex-1 h-8 text-base text-gray-900" password="{{!showConfirmPassword}}" placeholder="请再次输入新密码" placeholder-class="text-gray-400" value="{{formData.confirmPassword}}" bindinput="onInput" data-field="confirmPassword" />
        </view>
      </view>

      <!-- 提交按钮 -->
      <view class="mt-8">
        <button class="w-full bg-orange-main text-white rounded-full py-3 font-bold text-lg leading-none shadow-sm transition-all border-none" hover-class="scale-98" bindtap="handleSubmit">确认修改</button>
      </view>

    </view>
  </view>
</view>
