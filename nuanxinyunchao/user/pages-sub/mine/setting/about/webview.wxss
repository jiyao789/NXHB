/* Rich Text Styles Simulation for SCSS parsing */
.protocol-rich-text {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #4b5563; /* text-gray-600 */
  line-height: 1.8;
  font-size: 28rpx;
}

