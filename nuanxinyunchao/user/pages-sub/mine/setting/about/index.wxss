@import "../../../../styles/utilities.wxss";
@import "../../../../styles/icons.wxss";

view, text, image, scroll-view, input { box-sizing: border-box !important; }

.min-h-screen { min-height: 100vh; }
.bg-efecec { background-color: #efecec; }
.bg-white { background-color: #ffffff; }
.bg-gray-200 { background-color: #e5e7eb; }
.bg-gray-50 { background-color: #f9fafb; }
/* 🚀 补充：确保导航栏定位精准 */
.relative { position: relative; }
.absolute { position: absolute; }
.flex { display: flex; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }

/* 明确 left-2 的数值（Tailwind 默认 0.5rem = 16rpx） */
.left-2 { left: 16rpx; }

/* 确保按钮有明确宽高，否则点击区域会错位 */
.h-11 { height: 88rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }

/* 修正背景颜色，防止导航栏透明看到下面的内容 */
.bg-efecec { background-color: #efecec; }

/* 如果图标还是黑色，请确保颜色类名存在 */
.text-gray-900 { color: #111827; }
.text-gray-900 { color: #111827; }
.text-gray-600 { color: #4b5563; }
.text-gray-400 { color: #9ca3af; }
.text-gray-300 { color: #d1d5db; }

.h-11 { height: 88rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-30 { height: 240rpx; }
.w-30 { width: 240rpx; }
.h-1px { height: 2rpx; }
.w-95-pct { width: 95%; }

.pt-10 { padding-top: 80rpx; }
.p-4 { padding: 32rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.mx-4 { margin-left: 32rpx; margin-right: 32rpx; }
.mb-10 { margin-bottom: 80rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mx-auto { margin-left: auto; margin-right: auto; }

.font-bold { font-weight: 700; }
.rounded-full { border-radius: 9999rpx; }
.rounded-xl { border-radius: 24rpx; }
.rounded-2xl { border-radius: 32rpx; }

.active-bg-black-5:active { background-color: rgba(0, 0, 0, 0.05); }
.active-bg-gray-50:active { background-color: #f9fafb; }

/* 🚀 图标补丁 (URL Encoded) */
