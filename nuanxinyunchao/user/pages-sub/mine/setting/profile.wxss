.bg-efecec { background-color: #efecec; }
.min-h-screen { min-height: 100vh; display: flex; flex-direction: column; }
.fixed { position: fixed; z-index: 50; }
.relative { position: relative; }
.absolute { position: absolute; }
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-end { justify-content: flex-end; }
.overflow-hidden { overflow: hidden; }

.left-0 { left: 0; }
.right-0 { right: 0; }
.top-0 { top: 0; }
.left-2 { left: 16rpx; }
.left-4 { left: 32rpx; }
.right-4 { right: 32rpx; }
.bottom-0 { bottom: 0; }

.h-11 { height: 88rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-12 { height: 96rpx; }
.w-12 { width: 96rpx; }
.h-1px { height: 2rpx; }
.flex-1 { flex: 1; }
.w-full { width: 100%; }

.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.pt-3 { padding-top: 24rpx; }
.mx-4 { margin-left: 32rpx; margin-right: 32rpx; }
.gap-2 { gap: 16rpx; }
.gap-1 { gap: 8rpx; }
.ml-10 { margin-left: 80rpx; }
.mt-8 { margin-top: 64rpx; }

.rounded-full { border-radius: 9999px; }
.rounded-xl { border-radius: 24rpx; }
.border { border: 2rpx solid #f3f4f6; }
.bg-black-5 { background-color: rgba(0,0,0,0.05); }
.bg-gray-100 { background-color: #f3f4f6; }
.bg-gray-50 { background-color: #f9fafb; }
.bg-white { background-color: #ffffff; }
.bg-orange-main { background-color: #FF6B00; }

.text-lg { font-size: 36rpx; }
.text-sm { font-size: 28rpx; }
.text-xs { font-size: 24rpx; }
.text-gray-900 { color: #111827; }
.text-gray-800 { color: #1f2937; }
.text-gray-500 { color: #6b7280; }
.text-gray-400 { color: #9ca3af; }
.text-gray-300 { color: #d1d5db; }
.text-orange-main { color: #FF6B00; }
.text-white { color: #ffffff; }
.text-right { text-align: right; }
.font-bold { font-weight: bold; }

.shadow-sm { box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); }
.shadow-md { box-shadow: 0 4rpx 6rpx rgba(0,0,0,0.1); }
.opacity-80 { opacity: 0.8; }
