<view class="min-h-screen flex flex-col bg-efecec">
  <view class="fixed left-0 right-0 top-0 z-50 bg-efecec" style="padding-top: {{safeAreaTop}}px;">
    <view class="relative h-11 flex items-center justify-center px-4">
      <view class="absolute left-2 h-8 w-8 flex items-center justify-center rounded-full" hover-class="bg-black-5" bindtap="handleBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900"></view>
      </view>
      <text class="text-lg text-gray-900 font-bold">修改登录密码</text>
    </view>
  </view>
  
  <view style="height: {{safeAreaTop + 44}}px;"></view>

  <view class="px-6 pt-8">
    <view class="mb-8">
      <text class="text-2xl font-bold text-gray-900">修改密码</text>
      <text class="mt-2 block text-sm text-gray-400">为了您的账号安全，修改密码前请先进行短信验证</text>
    </view>

    <view class="overflow-hidden rounded-3xl bg-white p-6 shadow-sm">
      <view class="mb-6">
        <text class="mb-2 ml-1 block text-xs font-bold text-gray-400">手机号</text>
        <view class="flex h-12 items-center border-b border-gray-100">
          <input value="{{formData.phone}}" type="number" maxlength="11" placeholder="请输入手机号" class="flex-1 text-base no-outline" bindinput="onInput" data-field="phone" />
        </view>
      </view>

      <view class="mb-6">
        <text class="mb-2 ml-1 block text-xs font-bold text-gray-400">验证码</text>
        <view class="flex h-12 items-center border-b border-gray-100">
          <input value="{{formData.code}}" type="number" maxlength="6" placeholder="请输入验证码" class="flex-1 text-base no-outline" bindinput="onInput" data-field="code" />
          <view class="ml-2 text-sm font-bold transition-all p-2 rounded-2xl {{isCounting ? 'text-gray-300' : 'bg-orange-main text-white'}}" hover-class="opacity-70" bindtap="getCode">
            {{ isCounting ? count + 's后重发' : '获取验证码' }}
          </view>
        </view>
      </view>

      <view class="mb-8">
        <text class="mb-2 ml-1 block text-xs font-bold text-gray-400">新密码</text>
        <view class="flex h-12 items-center border-b border-gray-100">
          <input value="{{formData.password}}" password="{{!showPassword}}" placeholder="8-16位字母、数字组合" class="flex-1 text-base no-outline" bindinput="onInput" data-field="password" />
          <view class="{{showPassword ? 'i-carbon-view' : 'i-carbon-view-off'}} text-xl text-gray-300 p-2" bindtap="togglePassword"></view>
        </view>
      </view>

      <view class="h-12 w-full flex items-center justify-center rounded-full bg-orange-main text-white font-bold shadow-lg shadow-orange-100 transition-all" hover-class="scale-98" bindtap="handleConfirm">
        确认修改
      </view>
    </view>
  </view>
</view>
