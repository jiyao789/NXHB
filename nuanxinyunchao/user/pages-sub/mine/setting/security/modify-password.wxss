.bg-efecec { background-color: #efecec; }
.min-h-screen { min-height: 100vh; display: flex; flex-direction: column; }
.fixed { position: fixed; z-index: 50; }
.relative { position: relative; }
.absolute { position: absolute; }
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.overflow-hidden { overflow: hidden; }

.left-0 { left: 0; }
.right-0 { right: 0; }
.top-0 { top: 0; }
.left-2 { left: 16rpx; }

.h-11 { height: 88rpx; }
.h-12 { height: 96rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.w-full { width: 100%; }
.flex-1 { flex: 1; }

.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-6 { padding-left: 48rpx; padding-right: 48rpx; }
.pt-8 { padding-top: 64rpx; }
.p-6 { padding: 48rpx; }
.p-2 { padding: 16rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-6 { margin-bottom: 48rpx; }
.mb-8 { margin-bottom: 64rpx; }
.mt-2 { margin-top: 16rpx; }
.ml-1 { margin-left: 8rpx; }
.ml-2 { margin-left: 16rpx; }

.rounded-full { border-radius: 9999px; }
.rounded-3xl { border-radius: 48rpx; }
.rounded-2xl { border-radius: 32rpx; }
.bg-black-5 { background-color: rgba(0,0,0,0.05); }
.bg-white { background-color: #ffffff; }
.bg-orange-main { background-color: #FF6B00; }

.border-b { border-bottom: 2rpx solid transparent; }
.border-gray-100 { border-color: #f3f4f6; }

.text-2xl { font-size: 48rpx; }
.text-xl { font-size: 40rpx; }
.text-lg { font-size: 36rpx; }
.text-base { font-size: 32rpx; }
.text-sm { font-size: 28rpx; }
.text-xs { font-size: 24rpx; }

.text-gray-900 { color: #111827; }
.text-gray-400 { color: #9ca3af; }
.text-gray-300 { color: #d1d5db; }
.text-white { color: #ffffff; }
.font-bold { font-weight: bold; }
.block { display: block; }
.transition-all { transition: all 0.3s; }

.shadow-sm { box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); }
.shadow-lg { box-shadow: 0 10rpx 15rpx rgba(0,0,0,0.1); }
.shadow-orange-100 { box-shadow: 0 10rpx 15rpx rgba(255,107,0,0.2); }
.opacity-70 { opacity: 0.7; }
.scale-98 { transform: scale(0.98); }
.no-outline { outline: none; }
