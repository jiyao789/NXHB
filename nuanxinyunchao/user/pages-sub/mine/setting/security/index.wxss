@import "../../../../styles/utilities.wxss";
@import "../../../../styles/icons.wxss";

/* ==== 修复微信盒子模型 ==== */
view, text, image, scroll-view, input, button { box-sizing: border-box !important; }

/* ==== 特殊字符合规化映射 ==== */
.min-h-screen { min-height: 100vh; }
.bg-efecec { background-color: #efecec; }
.bg-white { background-color: #ffffff; }
.bg-gray-200 { background-color: #e5e7eb; }

.text-gray-900 { color: #111827; }
.text-gray-800 { color: #1f2937; }
.text-gray-300 { color: #d1d5db; }

/* 尺寸与高度 */
.h-11 { height: 88rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-1px { height: 2rpx; }

/* 字体排版 */
.text-2xl { font-size: 48rpx; }
.text-lg { font-size: 36rpx; }
.text-base { font-size: 32rpx; }
.font-bold { font-weight: 700; }

/* 边距与排版 */
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.pt-3 { padding-top: 24rpx; }
.p-4 { padding: 32rpx; }

.left-0 { left: 0; }
.right-0 { right: 0; }
.top-0 { top: 0; }
.bottom-0 { bottom: 0; }
.left-2 { left: 16rpx; }
.right-2 { right: 16rpx; }

/* 其他视觉 */
.rounded-full { border-radius: 9999rpx; }
.rounded-3xl { border-radius: 48rpx; }
.overflow-hidden { overflow: hidden; }
.z-50 { z-index: 50; }
.z-20 { z-index: 20; }
.shadow-md { box-shadow: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.1), 0 4rpx 8rpx -2rpx rgba(0, 0, 0, 0.06); }

/* 交互反馈 */
.active-bg-black-5:active { background-color: rgba(0, 0, 0, 0.05); }
.active-bg-gray-50:active { background-color: #f9fafb; }

