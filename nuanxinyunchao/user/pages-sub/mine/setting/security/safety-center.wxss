.bg-efecec { background-color: #efecec; }
.min-h-screen { min-height: 100vh; display: flex; flex-direction: column; }
.fixed { position: fixed; z-index: 50; }
.relative { position: relative; }
.absolute { position: absolute; }
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }

.left-0 { left: 0; }
.right-0 { right: 0; }
.top-0 { top: 0; }
.left-2 { left: 16rpx; }
.-bottom-1 { bottom: -8rpx; }
.-right-1 { right: -8rpx; }

.h-11 { height: 88rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-24 { height: 192rpx; }
.w-24 { width: 192rpx; }
.h-6 { height: 48rpx; }
.w-6 { width: 48rpx; }

.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-6 { padding-left: 48rpx; padding-right: 48rpx; }
.py-10 { padding-top: 80rpx; padding-bottom: 80rpx; }
.p-2 { padding: 16rpx; }
.p-4 { padding: 32rpx; }
.p-5 { padding: 40rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-10 { margin-top: 80rpx; }
.gap-3 { gap: 24rpx; }

.rounded-full { border-radius: 9999px; }
.rounded-3xl { border-radius: 48rpx; }
.rounded-40 { border-radius: 40rpx; }
.bg-black-5 { background-color: rgba(0,0,0,0.05); }
.bg-white { background-color: #ffffff; }
.bg-green-500-10 { background-color: rgba(34,197,94,0.1); }

.border { border: 2rpx solid transparent; }
.border-red-50 { border-color: #fef2f2; }

.text-5xl { font-size: 96rpx; }
.text-2xl { font-size: 48rpx; }
.text-xl { font-size: 40rpx; }
.text-lg { font-size: 36rpx; }
.text-sm { font-size: 28rpx; }
.text-xs { font-size: 24rpx; }
.text-10 { font-size: 20rpx; }

.text-gray-900 { color: #111827; }
.text-gray-800 { color: #1f2937; }
.text-gray-400 { color: #9ca3af; }
.text-gray-300 { color: #d1d5db; }
.text-green-500 { color: #22c55e; }
.text-orange-500 { color: #f97316; }
.text-red-500 { color: #ef4444; }

.font-bold { font-weight: bold; }
.block { display: block; }
.shadow-sm { box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); }
.shadow-md { box-shadow: 0 4rpx 6rpx rgba(0,0,0,0.1); }
.opacity-60 { opacity: 0.6; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .5; }
}
