@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* ==== 修复微信盒子模型 ==== */
view, text, image, scroll-view, button, input { box-sizing: border-box !important; }

/* ==== 特殊字符合规化映射 ==== */
.min-h-screen { min-height: 100vh; }
.bg-F5F5F5 { background-color: #F5F5F5; }
.text-333 { color: #333333; }
.text-E65100 { color: #E65100; }
.text-FF6B00 { color: #FF6B00; }
.text-4BA592 { color: #4BA592; }
.bg-E65100 { background-color: #E65100; }

.left-1-2 { left: 50%; }
.translate-x-minus-1-2 { transform: translateX(-50%); }

/* 尺寸与高度 */
.h-11 { height: 88rpx; }
.h-9 { height: 72rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-3px { height: 6rpx; }
.w-5 { width: 40rpx; }
.h-1px { height: 2rpx; }
.left-2 { left: 16rpx; }

/* 字体排版 */
.text-5xl { font-size: 96rpx; }
.text-3xl { font-size: 60rpx; }
.text-2xl { font-size: 48rpx; }
.text-15px { font-size: 30rpx; }
.text-13px { font-size: 26rpx; }
.text-lg { font-size: 36rpx; }
.text-sm { font-size: 28rpx; }
.text-xs { font-size: 24rpx; }

/* 边距 */
.gap-1-5 { gap: 12rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.px-2 { padding-left: 16rpx; padding-right: 16rpx; }
.pb-2 { padding-bottom: 16rpx; }
.pt-1 { padding-top: 8rpx; }
.mt-1 { margin-top: 8rpx; }
.py-2 { padding-top: 16rpx; padding-bottom: 16rpx; }
.pt-3 { padding-top: 24rpx; }
.pb-10 { padding-bottom: 80rpx; }
.py-20 { padding-top: 160rpx; padding-bottom: 160rpx; }
.pt-20 { padding-top: 160rpx; }
.mb-6 { margin-bottom: 48rpx; }
.mb-2 { margin-bottom: 16rpx; }
.p-4 { padding: 32rpx; }
.pr-4 { padding-right: 32rpx; }
.pl-1 { padding-left: 8rpx; }

/* 交互辅助 */
.active-bg-black-5:active { background-color: rgba(0, 0, 0, 0.05); }
.active-bg-gray-50:active { background-color: #f9fafb; }
.active-opacity-70:active { opacity: 0.7; }
.opacity-30 { opacity: 0.3; }
.transition-all { transition-property: all; transition-duration: 150ms; }
.shadow-sm { box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.05); }
.shadow-inner { box-shadow: inset 0 4rpx 8rpx 0 rgba(0, 0, 0, 0.05); }
.line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

/* ========================================== */
