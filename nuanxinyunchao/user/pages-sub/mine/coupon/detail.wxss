@import "../../../styles/utilities.wxss";
@import "../../../styles/icons.wxss";

/* ==== 修复微信盒子模型与 Button ==== */
view,
text,
image,
scroll-view,
input {
  box-sizing: border-box !important;
}

button {
  box-sizing: border-box !important;
  padding: 0;
  margin: 0;
  line-height: inherit;
  background-color: transparent;
}

button::after {
  border: none;
}

image {
  display: block;
}

/* ==== 原 scoped 样式搬运 ==== */
.custom-button:active,
.active-opacity-80:active {
  opacity: 0.8;
  transform: scale(0.96);
}

::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* ==== 特殊字符合规化映射 ==== */
