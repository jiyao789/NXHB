<view class="min-h-screen bg-f5f5f5 pb-30">

  <!-- 1. 自定义导航栏 -->
  <view class="fixed left-0 right-0 top-0 z-50 bg-transparent" style="padding-top: {{safeAreaInsetsTop}}px;">
    <view class="h-11 flex items-center px-1 relative">
      <view class="h-10 w-10 flex items-center justify-center rounded-full active-bg-black-5" bindtap="handleBack">
        <view class="i-carbon-chevron-left text-2xl text-gray-900" />
      </view>
      <view class="absolute left-1-2 translate-x-minus-1-2 text-lg font-bold text-gray-900">优惠券详情</view>
    </view>
  </view>
  <view style="height: {{safeAreaInsetsTop + 44}}px;" />

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="flex justify-center pt-20">
    <view class="i-carbon-circle-dash animate-spin text-3xl text-gray-300" />
  </view>

  <view wx:elif="{{loadError}}" class="flex flex-col items-center pt-24 px-8">
    <text class="text-sm text-gray-500">{{ loadError }}</text>
    <view class="mt-6 h-11 px-8 rounded-full bg-FF6B00 text-white flex items-center justify-center text-sm active-opacity-90" bindtap="handleBack">返回</view>
  </view>

  <block wx:elif="{{detail}}">
    <!-- 2. 门店信息 -->
    <view class="mx-4 mb-4 flex items-center justify-between pt-4">
      <view class="flex items-center gap-1 group active-opacity-70 {{ detail.merchantId ? '' : 'opacity-50' }}" bindtap="handleToStoreDetail">
        <text class="text-22px font-bold text-gray-800">{{ detail.storeName }}</text>
        <view wx:if="{{detail.merchantId}}" class="i-carbon-chevron-right text-lg text-gray-400 mt-1" />
      </view>
      <view class="flex items-center gap-3">
        <view class="flex flex-col items-center gap-1 {{ detail.phone ? '' : 'opacity-40' }}" bindtap="handleMakePhoneCall">
          <view class="p-1-5 rounded-4 bg-eeeeee flex items-center justify-center active-scale-90 transition-all">
            <view class="i-carbon-phone text-18px text-black" />
          </view>
        </view>
        <view class="flex flex-col items-center gap-1 {{ detail.latitude != null && detail.longitude != null ? '' : 'opacity-40' }}" bindtap="handleOpenMap">
          <view class="p-1-5 rounded-4 bg-eeeeee flex items-center justify-center active-scale-90 transition-all">
            <view class="i-carbon-location text-18px text-black" />
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 核心核销卡片 -->
    <view class="mx-4 bg-white rounded-3xl shadow-sm overflow-hidden flex flex-col">
      
      <!-- 卡片头部：券信息 -->
      <view class="p-5 flex items-start gap-4">
        <image src="{{ detail.avatar || 'https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/surroundings/bg_like_container.png' }}" class="h-20 w-20 rounded-xl bg-gray-100" mode="aspectFill" />
        <view class="flex-1 flex flex-col pt-1">
          <text class="text-18px font-bold text-gray-900 leading-tight">{{ detail.title }}</text>
          <text class="text-xs text-gray-500 mt-1-5">{{ detail.subTitle }}</text>
          <text class="text-xs text-gray-400 mt-1">有效期：{{ detail.validDate }}</text>
          <text class="text-xs text-gray-400">范围：{{ detail.scope }}</text>
          <text class="text-xs text-gray-400">随时退·过期自动退</text>
        </view>
      </view>

      <!-- 虚线分割线 1 (带侧边缺口) -->
      <view class="relative h-1px flex items-center justify-center">
        <view class="dash-line w-full mx-6" />
        <view class="arc-cut-left absolute left-0" />
        <view class="arc-cut-right absolute right-0" />
      </view>

      <!-- 卡片中部：核销二维码 -->
      <view wx:if="{{detail.showQr && detail.qrPayload}}" class="py-10 px-8 flex flex-col items-center justify-center">
        <canvas canvas-id="couponUseQrCanvas" style="width: {{qrCanvasPx}}px; height: {{qrCanvasPx}}px; margin: 0 auto;" />
        <text class="text-10px text-gray-400 mt-3">请向店员出示此码核销</text>
      </view>
      <view wx:else class="py-10 px-8 flex items-center justify-center">
        <text class="text-sm text-gray-400">暂无核销码</text>
      </view>

      <!-- 虚线分割线 2 -->
      <view class="relative h-1px flex items-center justify-center">
        <view class="dash-line w-full mx-6" />
        <view class="arc-cut-left absolute left-0" />
        <view class="arc-cut-right absolute right-0" />
      </view>

      <!-- 卡片底部：详情信息 -->
      <view class="p-6 pb-8 flex flex-col gap-4">
        <view class="flex items-center text-15px">
          <text class="text-gray-500 w-24">消耗积分</text>
          <text class="text-gray-900 font-medium">{{ detail.points }}</text>
        </view>
        <view class="flex items-center text-15px">
          <text class="text-gray-500 w-24">订单编号</text>
          <text class="text-gray-900 font-medium">{{ detail.orderNumber }}</text>
        </view>
        <view class="flex items-center text-15px">
          <text class="text-gray-500 w-24">兑换时间</text>
          <text class="text-gray-900 font-medium">{{ detail.redeemTime }}</text>
        </view>
      </view>

    </view>
  </block>

  <!-- 4. 底部固定按钮 -->
  <view class="fixed bottom-0 left-0 right-0 bg-white shadow-2xl-top px-6 pt-4 pb-safe flex items-center justify-center">
    <view class="h-12 w-full rounded-full bg-FFD700 flex items-center justify-center text-gray-900 font-bold text-lg active-scale-95 transition-all" bindtap="handleBack">
      取消
    </view>
  </view>

</view>
