<view class="h-screen flex flex-col overflow-hidden bg-gray-100" bindtap="hideSearchResults">
  
  <!-- 加载中 -->
  <view wx:if="{{detailLoading}}" class="fixed inset-0 z-200 flex items-center justify-center bg-black-20 backdrop-blur-sm">
    <text class="text-sm text-gray-700 font-medium bg-white-90 px-4 py-2 rounded-lg">加载中...</text>
  </view>

  <!-- 任务悬浮按钮 -->
  <view wx:if="{{taskInfo.active}}" class="fixed right-0 z-100 flex items-center shadow-lg transition-all task-floating-btn" bindtap="handleBackToTasks">
    <view class="flex items-center gap-2">
      <view class="h-4 w-4 flex items-center justify-center rounded-full bg-white-20">
        <view class="i-carbon-chevron-left text-white text-xs"></view>
      </view>
    </view>
  </view>

  <view class="relative h-50vh w-full overflow-hidden bg-gray-200">
    <image wx:if="{{staticMapUrl}}" src="{{staticMapUrl}}" class="absolute inset-0 h-full w-full" mode="aspectFill" bindtap="openRealMap" />
    <view wx:else class="absolute inset-0 h-full w-full bg-gray-300 flex items-center justify-center active-opacity-80" bindtap="openRealMap">
      <text class="text-xs text-gray-500">暂无地图，点击尝试导航</text>
    </view>
    
    <view class="pointer-events-none absolute left-0 right-0 top-0 z-0 h-32 bg-gradient-to-b from-black-40 to-transparent" />

    <view class="absolute left-0 right-0 top-0 z-50">
      <view style="height: {{safeAreaTop}}px" />
      <view class="h-11 flex items-center gap-3 px-4">
        <view class="h-8 w-8 flex items-center justify-center rounded-full bg-white-20 backdrop-blur-md transition-colors active-bg-white-40" bindtap="handleBack">
          <view class="i-carbon-chevron-left text-2xl text-white" />
        </view>
        <view class="h-8 flex flex-1 items-center border border-white-50 rounded-full bg-white-90 px-3 shadow-sm backdrop-blur-sm relative">
          <view class="i-carbon-search mr-2 text-sm text-gray-500" />
          <input type="text" placeholder="强国同学汇" placeholder-class="text-gray-400" class="h-full flex-1 text-xs text-gray-800" value="{{searchKeyword}}" bindfocus="onSearchFocus" bindinput="onSearchInput" />
          
          <!-- 搜索结果下拉面板 -->
          <view wx:if="{{showSearchResults}}" class="absolute left-0 right-0 z-50 bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden" style="top: calc(100% + 8px); max-height: 50vh;">
            <scroll-view scroll-y class="w-full h-full" style="max-height: 50vh;">
              <view class="flex flex-col">
                <view wx:if="{{searchResults.length === 0 && !isSearching}}" class="px-4 py-4 text-center text-xs text-gray-400">
                  暂无相关数据
                </view>
                <view wx:for="{{searchResults}}" wx:key="id" class="px-4 py-3 border-b border-gray-50 flex items-center justify-between active:bg-gray-50" catchtap="onSelectSearchResult" data-item="{{item}}">
                  <text class="text-sm text-gray-700 truncate flex-1">{{item.title}}</text>
                  <text class="text-10 text-orange-main border border-orange-main rounded px-1 ml-2 flex-shrink-0">{{item.type}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
        </view>
        <view class="w-20" />
      </view>
    </view>

    <view class="pointer-events-none absolute left-half top-half z-10 flex flex-col items-center translate-center">
      <view class="relative z-20 h-14 w-14 overflow-hidden border-3px border-white rounded-full bg-white shadow-lg">
        <image src="{{shopInfo.avatar}}" class="h-full w-full" mode="aspectFill" />
      </view>
      <view class="animate-bounce-slow relative z-10 mt-2 flex flex-col items-center border border-white-60 rounded-lg bg-white-95 px-3 py-1-5 shadow-lg backdrop-blur-sm">
        <text class="text-xs text-gray-800 font-bold">{{ shopInfo.name }}</text>
        <text class="text-10px text-orange-500 font-bold">点击导航</text>
        <view class="absolute pointer-arrow bg-white" />
      </view>
    </view>
  </view>

  <view class="relative z-20 flex flex-1 flex-col overflow-hidden rounded-t-40rpx shadow-up-lg -mt-8">
    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/hot/bg_down_detail.png" class="absolute inset-0 z-0 h-full w-full" mode="aspectFill" />

    <view class="relative z-10 h-full w-full flex flex-col">
      <view class="flex flex-shrink-0 flex-col items-center px-6 pb-4 pt-8">
        <view class="w-full flex flex-row items-start justify-start mb-2">
          
          <view class="h-19 w-19 flex items-center justify-center rounded-full bg-white mt-1">
            <image src="{{shopInfo.avatar}}" class="h-18 w-18 flex-shrink-0 rounded-full" mode="aspectFill" />
          </view>
      
          <view class="ml-3 flex flex-1 flex-row items-start justify-between">
            <view class="flex flex-col items-start justify-center">
              <view class="mb-1 flex flex-col items-start w-full gap-1">
                <text class="text-stroke-effect text-2xl text-E65100 font-black tracking-wide leading-tight">{{ shopInfo.name }}</text>
                <view wx:if="{{shopInfo.subTitle}}" class="flex flex-wrap items-center gap-2">
                  <text class="text-base text-black font-black tracking-wide">{{ shopInfo.subTitle }}</text>
                </view>
                <text wx:if="{{shopInfo.slogan}}" class="text-sm text-orange-600 font-medium leading-snug">{{ shopInfo.slogan }}</text>
              </view>
      
              <text class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap">营业时间：{{ shopInfo.businessHours }}\n地址：{{ shopInfo.address }}{{ shopInfo.intro ? '\n个性介绍：' + shopInfo.intro : '' }}</text>
            </view>
      
            <view class="flex flex-col items-center justify-between self-stretch py-1">
              <view class="h-8 w-8 flex items-center justify-center active-scale-90 transition-transform" catchtap="toggleFavorite">
                <view class="{{isFavorite ? 'i-carbon-star-filled text-orange-500' : 'i-carbon-star text-gray-400'}} text-xl" />
              </view>
      
              <view class="flex flex-col items-center gap-0-5 active-opacity-60" catchtap="openRealMap">
                <view class="h-6 w-6 flex items-center justify-center">
                  <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/near/icon_near.png" class="h-full w-full" mode="aspectFit" />
                </view>
                <text class="whitespace-nowrap text-10px text-gray-400 font-bold">{{ shopInfo.distance || '—' }}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="group relative z-30 flex items-center justify-center transition-opacity active-opacity-60" bindtap="handleToQrcode">
          <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/hot/bg_toQrcode.png" class="absolute left-0 top-0 h-full w-full -z-10" mode="scaleToFill" />
          <text class="relative top-0 z-10 px-4 pb-3 pt-1 text-base text-gray-900 font-black">向店员出示“暖新码”可享</text>
        </view>
      </view>

      <view class="min-h-0 w-full flex-1">
        <scroll-view scroll-y class="h-full w-full" show-scrollbar="{{false}}">
          <view class="pb-10 pt-2">
            <view class="w-full flex flex-col">
              
              <view wx:for="{{couponList}}" wx:key="id" class="mx-5 relative overflow-hidden h-105px mb-4 transition-transform active-scale-98" style="background-image: url('https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/mine/coupon/detail_card1.png'); background-size: 100% 100%; background-repeat: no-repeat;" bindtap="handleUse" data-id="{{item.id}}">
                <view class="flex items-stretch h-full">
                  <view class="w-100px flex-shrink-0 flex items-center justify-center">
                    <image src="{{item.image}}" class="w-18 h-18 rounded-lg" mode="aspectFill" />
                  </view>

                  <view class="w-1 flex-shrink-0" />

                  <view class="flex-1 flex flex-col justify-between py-3 pr-4 pl-2">
                    <view>
                      <view class="flex items-start justify-between">
                        <text class="text-15px text-gray-900 font-bold leading-tight line-clamp-1">{{ item.title }}</text>
                      </view>
                      <view class="mt-1 flex flex-row flex-wrap gap-1">
                        <text wx:if="{{item.couponKindLabel}}" class="bg-f1f2f2 text-10px text-gray-500 px-2 py-0-5 rounded border border-gray-100">{{item.couponKindLabel}}</text>
                        <text wx:if="{{item.scopeLabel}}" class="bg-f1f2f2 text-10px text-gray-500 px-2 py-0-5 rounded border border-gray-100">{{item.scopeLabel}}</text>
                      </view>
                    </view>

                    <view class="flex items-end justify-between">
                      <text class="text-11px text-gray-400 mb-0-5 line-clamp-1">{{ shopInfo.name }}</text>
                      <view class="m-0 h-6 flex items-center bg-FF6B00 text-white text-10px font-bold rounded-full px-4 shadow-sm active-opacity-80" style="width: auto !important; border: none;">{{ item.points }}积分兑换</view>
                    </view>
                  </view>
                </view>
              </view>

            </view>
          </view>
        </scroll-view>
      </view>
      
    </view>
  </view>

  <login-modal id="global-login-modal" />
</view>