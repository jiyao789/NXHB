/* 任务进度悬浮按钮样式 */
.task-floating-btn {
  top: 240rpx;
  background: linear-gradient(135deg, #ff7715, #ff9d42);
  color: #ffffff;
  padding: 16rpx 32rpx 16rpx 24rpx;
  border-top-left-radius: 100rpx;
  border-bottom-left-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 119, 21, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-right: none;
  z-index: 999;
}

.task-info-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

.animate-pulse-slow {
  animation: pulse 2s infinite ease-in-out;
}

.task-success-icon {
  width: 32rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}
.task-success-icon::after {
  content: '✓';
  color: #ff7715;
  font-size: 20rpx;
  font-weight: bold;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
.animate-bounce {
  animation: bounce 1s infinite;
}
