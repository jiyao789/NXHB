@import "../../styles/utilities.wxss";
@import "../../styles/icons.wxss";

/* ======================================================== */
/* Tailwind 原子类完整映射补丁 (解决无引擎导致的样式崩塌问题) */
/* ======================================================== */

/* 1. 宽高尺寸 (1rem = 16px = 32rpx) */
.h-screen { height: 100vh; }
.h-full { height: 100%; }
.w-full { width: 100%; }
.h-50vh { height: 50vh; }

.h-2 { height: 16rpx; }
.w-2 { width: 16rpx; }
.w-2px { width: 4rpx; }
.h-5 { height: 40rpx; }
.h-6 { height: 48rpx; }
.w-6 { width: 48rpx; }
.h-8 { height: 64rpx; }
.w-8 { width: 64rpx; }
.h-11 { height: 88rpx; }
.h-14 { height: 112rpx; }
.w-14 { width: 112rpx; }
.h-18 { height: 144rpx; }
.w-18 { width: 144rpx; }
.h-19 { height: 152rpx; }
.w-19 { width: 152rpx; }
.w-20 { width: 160rpx; }
.h-32 { height: 256rpx; }
.h-105px { height: 210rpx; }
.w-100px { width: 200rpx; }
.min-h-0 { min-height: 0; }

/* 2. 内外边距 (1 = 4px = 8rpx) */
.p-4 { padding: 32rpx; }
.px-3 { padding-left: 24rpx; padding-right: 24rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.px-6 { padding-left: 48rpx; padding-right: 48rpx; }
.py-1-5 { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }
.pt-1 { padding-top: 8rpx; }
.pt-2 { padding-top: 16rpx; }
.pt-8 { padding-top: 64rpx; }
.pb-4 { padding-bottom: 32rpx; }
.pb-10 { padding-bottom: 80rpx; }
.pl-2 { padding-left: 16rpx; }
.pr-4 { padding-right: 32rpx; }

.m-0 { margin: 0; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.-mt-8 { margin-top: -64rpx; }
.mb-0-5 { margin-bottom: 4rpx; }
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-4 { margin-bottom: 32rpx; }
.ml-3 { margin-left: 24rpx; }
.mx-2 { margin-left: 16rpx; margin-right: 16rpx; }
.mx-5 { margin-left: 40rpx; margin-right: 40rpx; }

/* 3. 颜色与背景 */
.bg-white { background-color: #ffffff; }
.bg-black { background-color: #000000; }
.bg-gray-100 { background-color: #f3f4f6; }
.bg-gray-200 { background-color: #e5e7eb; }
.bg-f1f2f2 { background-color: #f1f2f2; }
.bg-FF6B00 { background-color: #FF6B00; }
.bg-white-20 { background-color: rgba(255, 255, 255, 0.2); }
.bg-white-90 { background-color: rgba(255, 255, 255, 0.9); }
.bg-white-95 { background-color: rgba(255, 255, 255, 0.95); }

.text-white { color: #ffffff; }
.text-black { color: #000000; }
.text-gray-400 { color: #9ca3af; }
.text-gray-500 { color: #6b7280; }
.text-gray-800 { color: #1f2937; }
.text-gray-900 { color: #111827; }
.text-orange-500 { color: #f97316; }
.text-E65100 { color: #E65100; }

.from-black-40 { --tw-gradient-stops: rgba(0, 0, 0, 0.4), transparent; }
.bg-gradient-to-b { background-image: linear-gradient(to bottom, var(--tw-gradient-stops)); }

/* 4. 字体与排版 */
.text-10px { font-size: 20rpx; }
.text-11px { font-size: 22rpx; }
.text-xs { font-size: 24rpx; }
.text-sm { font-size: 28rpx; }
.text-15px { font-size: 30rpx; }
.text-base { font-size: 32rpx; }
.text-lg { font-size: 36rpx; }
.text-xl { font-size: 40rpx; }
.text-2xl { font-size: 48rpx; }

.font-bold { font-weight: 700; }
.font-black { font-weight: 900; }
.tracking-wide { letter-spacing: 0.025em; }
.leading-tight { line-height: 1.25; }
.leading-relaxed { line-height: 1.625; }

.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 5. 边框与圆角 */
.border { border-width: 2rpx; border-style: solid; border-color: #e5e7eb;}
.border-3px { border-width: 6rpx; border-style: solid; }
.border-white { border-color: #ffffff; }
.border-white-50 { border-color: rgba(255, 255, 255, 0.5); }
.border-white-60 { border-color: rgba(255, 255, 255, 0.6); }
.border-gray-100 { border-color: #f3f4f6; }

.rounded-lg { border-radius: 16rpx; }
.rounded-full { border-radius: 9999rpx; }
.rounded-t-40rpx { border-top-left-radius: 40rpx; border-top-right-radius: 40rpx; }

/* 6. 定位与层级 */
.absolute { position: absolute; }
.relative { position: relative; }
.fixed { position: fixed; }
.inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
.left-0 { left: 0; }
.right-0 { right: 0; }
.top-0 { top: 0; }
.left-half { left: 50%; }
.top-half { top: 50%; }
.z-0 { z-index: 0; }
.z-10 { z-index: 10; }
.z-20 { z-index: 20; }
.z-30 { z-index: 30; }
.z-50 { z-index: 50; }
.-z-10 { z-index: -10; }

/* 7. Flex 补强 */
.flex-shrink-0 { flex-shrink: 0; }
.self-stretch { align-self: stretch; }
.items-stretch { align-items: stretch; }
.gap-0-5 { gap: 4rpx; }

/* 8. 阴影与特效 */
.shadow-sm { box-shadow: 0 2rpx 4rpx 0 rgba(0, 0, 0, 0.05); }
.shadow-lg { box-shadow: 0 20rpx 30rpx -6rpx rgba(0, 0, 0, 0.1), 0 8rpx 12rpx -4rpx rgba(0, 0, 0, 0.05); }
.shadow-up-lg { box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.08); }
.backdrop-blur-sm { backdrop-filter: blur(8rpx); }
.backdrop-blur-md { backdrop-filter: blur(24rpx); }
.translate-center { transform: translate(-50%, -50%); }

/* 气泡上的箭头特殊处理 */
.pointer-arrow {
  left: 50%;
  top: -8rpx;
  transform: translateX(-50%) rotate(45deg);
}

/* 9. 交互反馈 */
.pointer-events-none { pointer-events: none; }
.transition-colors { transition-property: background-color, border-color, color, fill, stroke; transition-duration: 150ms; }
.transition-transform { transition-property: transform; transition-duration: 150ms; }
.transition-opacity { transition-property: opacity; transition-duration: 150ms; }

.active-bg-white-40:active { background-color: rgba(255, 255, 255, 0.4); }
.active-scale-90:active { transform: scale(0.9); }
.active-scale-98:active { transform: scale(0.98); }
.active-opacity-60:active { opacity: 0.6; }
.active-opacity-80:active { opacity: 0.8; }

/* ==== 核心特效补全 ==== */
view, text, image, scroll-view, button, input {
  box-sizing: border-box !important;
}

.text-stroke-effect {
  text-shadow:
    4rpx 4rpx 0 #fff, -4rpx -4rpx 0 #fff,
    4rpx -4rpx 0 #fff, -4rpx 4rpx 0 #fff,
    4rpx 0px 0 #fff, 0px 4rpx 0 #fff,
    -4rpx 0px 0 #fff, 0px -4rpx 0 #fff;
}

@keyframes bounce-slow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.animate-bounce-slow {
  animation: bounce-slow 2s infinite ease-in-out;
}

/* 任务进度悬浮按钮样式 */
.task-floating-btn {
  top: 240rpx;
  background: linear-gradient(135deg, #ff7715, #ff9d42);
  color: #ffffff;
  padding: 16rpx 32rpx 16rpx 24rpx;
  border-top-left-radius: 100rpx;
  border-bottom-left-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 119, 21, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-right: none;
  z-index: 999;
}

.task-info-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

.animate-pulse-slow {
  animation: pulse 2s infinite ease-in-out;
}

.task-success-icon {
  width: 32rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}
.task-success-icon::after {
  content: '✓';
  color: #ff7715;
  font-size: 20rpx;
  font-weight: bold;
}

.animate-bounce {
  animation: bounce 1s infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}