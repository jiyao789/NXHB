<view class="h-screen flex flex-col overflow-hidden pt-24 relative" bindtap="hideSearchResults">
  <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/bg.png" class="absolute inset-0 z-0 w-full h-full" mode="scaleToFill"></image>

  <!-- 任务悬浮按钮 -->
  <view wx:if="{{taskInfo.active}}" class="fixed right-0 z-100 flex items-center shadow-lg transition-all task-floating-btn" bindtap="handleBackToTasks">
    <view class="flex items-center gap-2">
      <view class="h-4 w-4 flex items-center justify-center rounded-full bg-white-20">
        <view class="i-carbon-chevron-left text-white text-xs"></view>
      </view>
    </view>
  </view>

  <!-- 顶部导航栏 -->
  <view class="fixed left-0 right-0 top-0 z-50 px-4 pb-2 pt-12 transition-colors" style="background-color: {{scrollTop > 40 ? '#e6d144' : 'transparent'}};">
    <view class="flex items-center justify-between">
      <view class="flex items-center gap-2">
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/logo.png" mode="heightFix" class="h-6 w-6 flex-shrink-0"></image>
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/logo_title.png" mode="heightFix" class="h-4 w-16 flex-shrink-0"></image>
      </view>
      <view class="mx-3 h-8 flex flex-1 items-center rounded-full bg-black-20 px-3 backdrop-blur-sm transition-all relative">
        <view class="i-carbon-search mr-2 text-white"></view>
        <input type="text" placeholder="强国同学汇" placeholder-class="text-white opacity-80" class="h-full flex-1 text-xs text-white" value="{{searchKeyword}}" bindfocus="onSearchFocus" bindinput="onSearchInput" />
        
        <!-- 搜索结果下拉面板 -->
        <view wx:if="{{showSearchResults}}" class="absolute left-0 right-0 z-50 bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden" style="top: calc(100% + 8px); max-height: 50vh;">
          <scroll-view scroll-y class="w-full h-full" style="max-height: 50vh;">
            <view class="flex flex-col">
              <view wx:if="{{searchResults.length === 0 && !isSearching}}" class="px-4 py-4 text-center text-xs text-gray-400">
                暂无相关数据
              </view>
              <view wx:for="{{searchResults}}" wx:key="id" class="px-4 py-3 border-b border-gray-50 flex items-center justify-between active:bg-gray-50" bindtap="onSelectSearchResult" data-item="{{item}}">
                <text class="text-sm text-gray-700 truncate flex-1">{{item.title}}</text>
                <text class="text-10 text-orange-main border border-orange-main rounded px-1 ml-2 flex-shrink-0">{{item.type}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="w-18"></view>
    </view>
  </view>

  <!-- Banner -->
  <view class="relative z-10 px-4 pt-2 flex-shrink-0">
    <swiper class="h-40 w-full overflow-hidden rounded-2xl bg-gray-200 shadow-md" indicator-dots="{{false}}" autoplay="{{true}}" circular="{{true}}" interval="{{4000}}" bindchange="onBannerChange">
      <swiper-item wx:for="{{bannerList}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" class="h-full w-full"></image>
      </swiper-item>
    </swiper>
    <view class="pointer-events-none absolute bottom-0 left-0 right-0 z-10 h-55 bg-gradient-to-t"></view>
    <view class="absolute bottom-10 right-8 z-20 flex items-center gap-1-5">
      <view wx:for="{{bannerList}}" wx:key="*this" class="h-1-5 rounded-full bg-white shadow-sm backdrop-blur-sm transition-all duration-300 {{currentBannerIndex === index ? 'w-4 opacity-100' : 'w-1-5 opacity-60'}}"></view>
    </view>
  </view>

  <view class="relative z-20 flex-1 flex flex-col px-4 pt-8 -mt-6 overflow-hidden pb-10">
    <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/hot/bg_down.png" class="absolute inset-0 z-0 h-full w-full" mode="scaleToFill"></image>

    <view class="relative z-50 flex-1 flex flex-col rounded-t-2xl bg-white overflow-hidden py-3">
      <view class="mb-3 px-1 flex-shrink-0 mx-3">
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/hot/find_hot.png" mode="heightFix" class="h-6"></image>
      </view>

      <!-- 筛选栏菜单 -->
      <view class="relative z-70 mb-4 flex items-center gap-8 px-1 flex-shrink-0 mx-3">
        <view bindtap="toggleMenu" data-type="landmark" class="flex items-center gap-1 py-1">
          <text class="text-sm font-bold {{selectedLandmarks.length > 0 || showLandmarkMenu ? 'text-orange-main' : 'text-gray-666'}}">地标</text>
          <view class="triangle {{showLandmarkMenu || selectedLandmarks.length > 0 ? 'triangle-active' : ''}}"></view>
        </view>

        <view bindtap="toggleMenu" data-type="activity" class="flex items-center gap-1 py-1">
          <text class="text-sm font-bold {{selectedActivities.length > 0 || showActivityMenu ? 'text-orange-main' : 'text-gray-666'}}">活动</text>
          <view class="triangle {{showActivityMenu || selectedActivities.length > 0 ? 'triangle-active' : ''}}"></view>
        </view>

        <view wx:if="{{showLandmarkMenu || showActivityMenu}}" class="absolute left-0 right-0 top-65 z-70 bg-white border-b border-orange-50 px-4 py-4 rounded-b-2xl shadow-xl -mx-3">
          <view wx:if="{{showLandmarkMenu}}" class="flex flex-wrap gap-2">
            <view wx:for="{{landmarkOptions}}" wx:key="*this" bindtap="selectOption" data-type="landmark" data-opt="{{item}}" class="filter-tag {{tools.includes(selectedLandmarks, item) ? 'filter-tag-active' : ''}}">{{item}}</view>
          </view>
          <view wx:if="{{showActivityMenu}}" class="flex flex-wrap gap-2">
            <view wx:for="{{activityOptions}}" wx:key="*this" bindtap="selectOption" data-type="activity" data-opt="{{item}}" class="filter-tag {{tools.includes(selectedActivities, item) ? 'filter-tag-active' : ''}}">{{item}}</view>
          </view>
        </view>
      </view>

      <view class="relative flex-1 overflow-hidden">
        <view wx:if="{{showLandmarkMenu || showActivityMenu}}" bindtap="closeDropdown" class="absolute inset-0 z-40 bg-black-20 transition-opacity duration-300" style="left:-50rpx; right:-50rpx;"></view>

        <scroll-view scroll-y class="h-full w-full" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="flex flex-col gap-4 pb-10 mx-3">
            <view wx:for="{{filteredRankList}}" wx:key="id" class="relative flex items-start gap-3 overflow-hidden rounded-md p-3 transition-all rank-card-{{index}}" bindtap="handleShopClick" data-item="{{item}}">

              <view wx:if="{{index <= 2}}" class="absolute left-0 top-0 z-10 h-6 px-3 flex items-center justify-center text-xs text-white font-bold shadow-sm">
                <view class="absolute inset-0 -skew-x-24 origin-top-left rounded-br-sm shadow-sm rounded-tr-md rounded-bl-sm rank-badge-{{index}}"></view>
                <text class="relative z-10 pr-1">{{ index + 1 }}</text>
              </view>

              <view class="flex-shrink-0 overflow-hidden rounded-full bg-gray-200" style="width: 128rpx; height: 128rpx;">
                <image src="{{item.image}}" mode="aspectFill" class="h-full w-full"></image>
              </view>

              <view class="flex flex-1 flex-col gap-1 py-1 pl-2">
                <view class="flex justify-between items-start">
                  <view class="flex flex-1 flex-wrap items-center gap-2 pr-2">
                    <text class="text-base text-gray-600 font-bold">{{ item.title }}</text>
                    <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" class="border border-orange-200 rounded bg-orange-light px-1 py-0-5 text-10 text-white">{{ tag.text }}</view>
                  </view>
                  <view class="flex-shrink-0 rounded px-2 py-0-5 text-10 bg-orange-bg text-orange-main">{{ item.status }}</view>
                </view>
                <view class="flex justify-between items-center mt-0-5">
                  <text class="text-xs text-gray-500">{{ item.category }} {{ item.area }}</text>
                  <text class="text-xs text-gray-400">{{ item.distance }}</text>
                </view>
                <view class="flex items-center gap-1 text-10 text-gray-500 mt-auto">
                  <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/icon_hot.png" class="w-2-5" mode="widthFix"></image>
                  <text>近30天{{ item.hotCount }}人打卡</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <login-modal id="global-login-modal" />
</view>

<wxs module="tools">
module.exports = {
  includes: function(arr, val) {
    if (!arr) return false;
    return arr.indexOf(val) !== -1;
  }
}
</wxs>


<!-- 动态注入返回智慧党建飘窗 -->
<global-home-btn />

<!-- 动态注入子包底部导航栏 -->
<nxyc-tabbar role="user" selected="2" />
