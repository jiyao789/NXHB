/* 筛选面板交互 */
.triangle {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #999;
  transition: transform 0.3s;
}
.triangle-active {
  border-top-color: #ff7715;
  transform: rotate(180deg);
}

.filter-tag {
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  background: #f7f7f7;
  color: #232323;
  border: 1rpx solid transparent;
}
.filter-tag-active {
  background: #fff3eb;
  color: #ff7715;
  border-color: #ff7715;
  font-weight: bold;
}

/* 排行榜卡片样式转化 */
.rank-card-0 { background: linear-gradient(to right, #f5d6b7 0%, #fdf6ef 50%, #ffffff 100%); }
.rank-card-1 { background: linear-gradient(to right, #f8ebcd 0%, #fdf8f2 50%, #ffffff 100%); }
.rank-card-2 { background: linear-gradient(to right, #f0d8c6 0%, #fdf9f5 50%, #ffffff 100%); }
.rank-card-3, .rank-card-4, .rank-card-5, .rank-card-6 { background: #f7f7f7; }

.rank-badge-0 { background: linear-gradient(to bottom, #e9592d, #fe8b5f); }
.rank-badge-1 { background: linear-gradient(to bottom, #e29d3d, #eed073); }
.rank-badge-2 { background: linear-gradient(to bottom, #ce7c40, #dfac84); }

.-skew-x-24 { transform: skewX(-24deg); }
.origin-top-left { transform-origin: top left; }

/* 任务进度悬浮按钮样式 */
.task-floating-btn {
  top: 240rpx;
  background: linear-gradient(135deg, #ff7715, #ff9d42);
  color: #ffffff;
  padding: 16rpx 32rpx 16rpx 24rpx;
  border-top-left-radius: 100rpx;
  border-bottom-left-radius: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 119, 21, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-right: none;
  z-index: 999;
}

.task-info-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

@keyframes pulse {
  0% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(0.9); }
  100% { opacity: 1; transform: scale(1); }
}

.animate-pulse-slow {
  animation: pulse 2s infinite ease-in-out;
}

.task-success-icon {
  width: 32rpx;
  height: 32rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}
.task-success-icon::after {
  content: '✓';
  color: #ff7715;
  font-size: 20rpx;
  font-weight: bold;
}

