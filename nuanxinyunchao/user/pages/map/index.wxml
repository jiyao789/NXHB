<view class="flex flex-col h-screen overflow-hidden bg-white" bindtap="hideSearchResults">
  <!-- 导航栏 -->
  <view class="relative z-50 flex-shrink-0 bg-white px-4 pb-2" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px; box-sizing: border-box;">
    <view class="flex items-center justify-between h-full w-full">
      <view class="flex items-center gap-2 flex-shrink-0">
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/logo.png"
          mode="heightFix" class="h-6 w-6 flex-shrink-0"></image>
        <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/logo_title.png"
          mode="heightFix" class="h-4 w-16 flex-shrink-0"></image>
      </view>
      <view class="mx-3 h-8 flex flex-1 items-center rounded-full bg-black-20 px-3 backdrop-blur-sm transition-all relative">
        <icon type="search" size="14" color="#ffffff" class="mr-2" />
        <input type="text" placeholder="强国同学汇" placeholder-class="text-white opacity-80" class="h-full flex-1 text-xs text-white" value="{{searchKeyword}}" bindfocus="onSearchFocus" bindinput="onSearchInput" />
        
        <!-- 搜索结果下拉面板 -->
        <view wx:if="{{showSearchResults}}" class="absolute left-0 right-0 z-50 bg-white rounded-xl shadow-lg border border-gray-100 overflow-hidden" style="top: calc(100% + 8px); max-height: 50vh;">
          <scroll-view scroll-y class="w-full h-full" style="max-height: 50vh;">
            <view class="flex flex-col">
              <view wx:if="{{searchResults.length === 0 && !isSearching}}" class="px-4 py-4 text-center text-xs text-gray-400">
                暂无相关数据
              </view>
              <view wx:for="{{searchResults}}" wx:key="id" class="px-4 py-3 border-b border-gray-50 flex items-center justify-between active:bg-gray-50" catchtap="onSelectSearchResult" data-item="{{item}}">
                <text class="text-sm text-gray-700 truncate flex-1">{{item.title}}</text>
                <text class="text-10 text-orange-main border border-orange-main rounded px-1 ml-2 flex-shrink-0">{{item.type}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="w-18 flex-shrink-0"></view>
    </view>
  </view>

  <!-- 地图区域 -->
  <view class="relative flex-1 overflow-hidden">
    <!-- 悬浮筛选栏 -->
    <view class="absolute left-0 right-0 top-0 z-20 transition-all" style="transform: translateY(-2rpx);">
      <view class="bg-white">
        <view class="mb-2 flex justify-center pt-2">
          <image src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/index/text_warm_map.png"
            class="h-8" mode="heightFix"></image>
        </view>

        <scroll-view scroll-x class="w-full whitespace-nowrap" show-scrollbar="{{false}}">
          <view class="inline-flex items-center gap-3 px-6 pb-3 pt-2">
            <view wx:for="{{categoryList}}" wx:key="id" bindtap="handleCategoryChange" data-id="{{item.id}}"
              class="flex flex-shrink-0 items-center gap-1 rounded-full px-3 py-1-5 shadow-sm transition-all duration-300 {{activeCategory === item.id ? 'bg-gradient-orange text-white shadow-lg font-bold' : 'bg-white-80 border-gray text-gray-600'}}">
              <image src="{{activeCategory === item.id ? item.icon : (item.orangeIcon || item.icon)}}"
                class="h-4 w-4" mode="aspectFit"></image>
              <text class="text-xs">{{ item.name }}</text>
            </view>
            <view class="w-2"></view>
          </view>
        </scroll-view>
      </view>
      <!-- 白色到透明的渐变遮罩 -->
      <view class="h-8 w-full bg-gradient-white pointer-events-none"></view>
    </view>

    <!-- 地图 -->
    <map id="myMap" class="w-full h-full" show-location="{{true}}"
      latitude="{{latitude}}" longitude="{{longitude}}" markers="{{displayMarkers}}" scale="{{scale}}"
      bindmarkertap="markertap" bindcallouttap="callouttap" bindtap="hideSearchResults">
      <cover-view slot="callout">
        <block wx:for="{{displayMarkers}}" wx:key="id">
          <cover-view marker-id="{{item.id}}" class="custom-callout">
            <cover-image class="callout-bg" mode="aspectFill"
              src="https://nuanxin-images-1329191669.cos.ap-guangzhou.myqcloud.com/bg_marker_orange.png"></cover-image>
            <cover-view class="callout-content">
              <cover-image src="{{item.customData.icon}}" class="bubble-icon" mode="aspectFill"></cover-image>
              <cover-view class="bubble-text">{{ item.customData.title }}</cover-view>
            </cover-view>
          </cover-view>
        </block>
      </cover-view>
    </map>
  </view>
  
  <login-modal id="global-login-modal" />
</view>



<!-- 动态注入返回智慧党建飘窗 -->
<global-home-btn />

<!-- 动态注入子包底部导航栏 -->
<nxyc-tabbar role="user" selected="1" />
